# UstaGO local environment. Copy to .env and adjust: cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# App-specific examples: apps/admin/.env.example, apps/mobile/.env.example

# --- Docker Compose (local PostgreSQL + Redis) ---
POSTGRES_USER=ustago
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ustago
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API (apps/api) ---
NODE_ENV=development
APP_VERSION=0.0.0-dev
API_PORT=3000
# Comma-separated list of allowed browser origins (admin 3001, Expo web 8081).
API_CORS_ORIGINS=http://localhost:3001,http://localhost:8081
API_SWAGGER_ENABLED=true
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Must match the Docker Compose values above.
DATABASE_URL=postgresql://ustago:change-me-local-only@localhost:5432/ustago?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (docs/adr/0007-auth-ve-token-stratejisi.md) ---
# Access-token signing key, min 32 chars. Local placeholder only: the API
# refuses to start in production with a value containing "change-me".
# Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-only-jwt-secret-0000000000
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_SESSION_MAX_DAYS=90
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Phone OTP and SMS (docs/adr/0009-telefon-otp-ve-sms.md) ---
# console: prints the code to the API log (development only)
# fake:    keeps codes in memory for tests
# disabled: refuses to send; a real provider is added before launch.
# The API refuses console/fake in production and never returns codes.
SMS_PROVIDER=console
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_WINDOW_SECONDS=3600
# Local demo switches accounts often; the production default stays 5.
OTP_MAX_REQUESTS_PER_WINDOW=20
# HMAC key for stored code hashes (min 32 chars). Optional locally (derived
# from JWT_ACCESS_SECRET), required in production.
OTP_HASH_SECRET=

# --- Notifications and push (docs/adr/0017-bildirim-outbox-ve-expo-push.md) ---
# console: "[DEV PUSH]" log lines only, nothing leaves the server (dev only).
# expo: Expo Push API (needs a real device token from a build with an EAS projectId).
# disabled: push rows are skipped; in-app notifications still work.
PUSH_PROVIDER=console
# Only when Expo "Enhanced push security" is on. Never commit a real token.
EXPO_ACCESS_TOKEN=
PUSH_WORKER_INTERVAL_SECONDS=5
PUSH_MAX_ATTEMPTS=5
PUSH_RECEIPT_DELAY_SECONDS=900

# --- Verification documents (docs/adr/0011-dogrulama-belgeleri-ve-nesne-depolama.md) ---
# local: files under STORAGE_LOCAL_DIR, served only via signed URLs (dev/test).
# disabled: uploads refused. Production needs an S3-compatible adapter.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Base URL the signed links point to (the API itself for the local driver).
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
# HMAC key for signed links (min 32 chars); required in production.
STORAGE_SIGNING_SECRET=
VERIFICATION_MAX_FILE_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=900
DOCUMENT_URL_TTL_SECONDS=120

# --- Marketplace (docs/adr/0014-talep-teklif-ve-acil.md) ---
# A QUOTE request stays open this long (hours); a NOW request (minutes).
QUOTE_REQUEST_TTL_HOURS=336
NOW_REQUEST_TTL_MINUTES=60
# How many providers a NOW request is offered to at once.
NOW_DISPATCH_WAVE_SIZE=20
# Background sweep that expires old requests (seconds, 0 = off).
REQUEST_EXPIRY_SWEEP_SECONDS=60
REQUEST_PHOTO_MAX_BYTES=10485760
# "Today" on the admin dashboard is computed in this IANA time zone.
MARKETPLACE_TIME_ZONE=Europe/Istanbul

# --- Finance (docs/adr/0018-0020) ---
# mock: test payments/payouts only, NO real money moves (refused in production).
# disabled: online payments / payouts answer 503.
PAYMENT_PROVIDER=mock
PAYOUT_PROVIDER=mock
PAYMENTS_ENABLED=true
CASH_ENABLED=true
PAYOUTS_ENABLED=true
# HMAC key for mock webhooks (min 32 chars). Optional locally.
MOCK_PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Development values only. Production must set its own (the API refuses to
# boot in production without them); they are business decisions.
FINANCE_EARNING_HOLD_HOURS=0
FINANCE_MIN_PAYOUT_MINOR=10000
FINANCE_CASH_COMMISSION_ENABLED=true
FINANCE_DEBT_OFFSET_ENABLED=true
FINANCE_MAX_PAYMENT_ATTEMPTS=5
FINANCE_SWEEP_SECONDS=15

# --- Seed (development only) ---
# Password for the demo accounts (pnpm dev:seed). `pnpm dev:setup` fills a
# random one; when empty the seed generates one and prints it once.
SEED_DEV_PASSWORD=
