{
  "name": "ustago",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ustago/api prisma:generate",
    "db:migrate": "pnpm --filter @ustago/api prisma:migrate",
    "db:deploy": "pnpm --filter @ustago/api prisma:deploy",
    "db:seed": "pnpm --filter @ustago/api prisma:seed",
    "db:reset": "pnpm --filter @ustago/api prisma:reset",
    "db:validate": "pnpm --filter @ustago/api prisma:validate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.5"
  }
}
