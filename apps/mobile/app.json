{
  "expo": {
    "name": "UstaGO",
    "slug": "ustago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ustago.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ustago.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "ustago",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Adresinizi otomatik doldurmak için konumunuz yalnızca siz istediğinizde kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Talebinize fotoğraf eklemek için galerinize erişim gerekir.",
          "cameraPermission": "Talebinize fotoğraf çekmek için kameranıza erişim gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
