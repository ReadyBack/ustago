// UstaGO database schema (Phase 1 domain core).
//
// Conventions (docs/adr/0003, 0006, 0008):
// - Every table has a UUIDv7 `id` (time-ordered, generated by Prisma).
//   Exceptions: provinces use the official plate code (1-81); pure join
//   tables use a composite key; 1:1 extension tables (provider_scores) use
//   the owner's id.
// - Table and column names are snake_case via @@map / @map; code uses camelCase.
// - Money is BigInt minor units (kuruş for TRY) plus a `currency`; never Float.
// - Timestamps are timestamptz and stored in UTC.
// - Append-only history tables (quote revisions, job status history, ledger
//   entries, trust events, audit logs) have `createdAt` but no `updatedAt`:
//   their rows are never edited.
// - Mutable aggregates that several actors race on carry a `version` column
//   for optimistic locking (service requests, quotes, jobs, change orders,
//   payments).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  /// Partial unique indexes back invariants such as "one default address"
  /// and "one active OTP per phone" (ADR-0009, ADR-0011).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Shared enums
// ============================================================================

/// ISO 4217. Adding a currency is a one-line enum migration.
enum CurrencyCode {
  TRY
}

// ============================================================================
// Identity, roles and sessions
// ============================================================================

enum UserStatus {
  ACTIVE
  /// Cannot sign in until an admin reactivates the account.
  SUSPENDED
  BANNED
}

/// A user can hold several roles at once (ADR-0005). CUSTOMER is granted to
/// every account; PROVIDER is added when the user opens a provider profile.
enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased and trimmed by the API.
  email           String?    @unique @db.VarChar(254)
  /// E.164, e.g. +905321234567.
  phone           String?    @unique @db.VarChar(20)
  /// Argon2id hash. Null for accounts that will only use OTP login later.
  passwordHash    String?    @map("password_hash")
  firstName       String     @map("first_name") @db.VarChar(80)
  lastName        String     @map("last_name") @db.VarChar(80)
  status          UserStatus @default(ACTIVE)
  locale          String     @default("tr-TR") @db.VarChar(10)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete; personal data is anonymised by a later KVKK job.
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  roles                     UserRole[]                    @relation("UserRoles")
  grantedRoles              UserRole[]                    @relation("RoleGrantedBy")
  customerProfile           CustomerProfile?
  providerProfile           ProviderProfile?
  addresses                 Address[]
  sessions                  AuthSession[]
  devices                   Device[]
  otpChallenges             OtpChallenge[]
  uploadIntents             UploadIntent[]
  providersReviewed         ProviderProfile[]             @relation("ProviderReviewedBy")
  notifications             Notification[]
  quoteRevisions            QuoteRevision[]
  jobStatusChanges          JobStatusHistory[]
  jobsCancelled             Job[]                         @relation("JobCancelledBy")
  changeOrdersAsked         ChangeOrder[]                 @relation("ChangeOrderRequestedBy")
  changeOrdersAnswer        ChangeOrder[]                 @relation("ChangeOrderRespondedBy")
  paymentsMade              Payment[]
  reviewsWritten            Review[]                      @relation("ReviewAuthor")
  reviewsReceived           Review[]                      @relation("ReviewTarget")
  reviewsModerated          Review[]                      @relation("ReviewModeratedBy")
  notificationPrefs         NotificationPreference?
  verificationsDone         ProviderVerification[]
  trustEvents               TrustEvent[]
  disciplinary              DisciplinaryAction[]          @relation("DisciplineSubject")
  disciplineDecided         DisciplinaryAction[]          @relation("DisciplineDecidedBy")
  appeals                   Appeal[]                      @relation("AppealBy")
  appealsReviewed           Appeal[]                      @relation("AppealReviewedBy")
  disputesOpened            Dispute[]                     @relation("DisputeOpenedBy")
  disputesAgainst           Dispute[]                     @relation("DisputeAgainst")
  disputesResolved          Dispute[]                     @relation("DisputeResolvedBy")
  evidence                  Evidence[]
  auditLogs                 AuditLog[]
  refundsRequested          Refund[]                      @relation("RefundRequestedBy")
  feePoliciesCreated        PlatformFeePolicy[]           @relation("FeePolicyCreatedBy")
  cashDisputed              CashSettlement[]              @relation("CashDisputedBy")
  cashResolved              CashSettlement[]              @relation("CashResolvedBy")
  payoutsRequested          Payout[]                      @relation("PayoutRequestedBy")
  payoutsDecided            Payout[]                      @relation("PayoutDecidedBy")
  ledgerTransactions        LedgerTransaction[]           @relation("LedgerTransactionCreatedBy")
  feePoliciesPublished      PlatformFeePolicy[]           @relation("FeePolicyPublishedBy")
  feePoliciesRetired        PlatformFeePolicy[]           @relation("FeePolicyRetiredBy")
  adminPermissions          AdminPermissionGrant[]        @relation("AdminPermissionHolder")
  permissionsGranted        AdminPermissionGrant[]        @relation("AdminPermissionGrantedBy")
  verificationCasesReviewed ProviderVerificationCase[]    @relation("VerificationCaseReviewer")
  verificationCasesDecided  ProviderVerificationCase[]    @relation("VerificationCaseDecider")
  verificationEvents        ProviderVerificationEvent[]
  suspensionsCreated        ProviderSuspension[]          @relation("SuspensionCreatedBy")
  suspensionsLifted         ProviderSuspension[]          @relation("SuspensionLiftedBy")
  requirementsSet           CategoryProviderRequirement[]
  riskSignals               RiskSignal[]                  @relation("RiskSignalSubject")
  riskSignalsReviewed       RiskSignal[]                  @relation("RiskSignalReviewer")
  alertsAcknowledged        OperationalAlert[]            @relation("AlertAcknowledgedBy")
  alertsResolved            OperationalAlert[]            @relation("AlertResolvedBy")
  runtimeFlags              RuntimeFlag[]
  deletionRequests          AccountDeletionRequest[]
  dataExports               DataExportRequest[]
  destinationsVerified      PayoutDestination[]           @relation("PayoutDestinationVerifiedBy")
  // Faz 7
  reviewReplies             ProviderReviewReply[]
  conversationParticipants  ConversationParticipant[]
  messagesSent              Message[]                     @relation("MessageSender")
  messageReports            MessageReport[]               @relation("MessageReporter")
  messageReportsReviewed    MessageReport[]               @relation("MessageReportReviewer")
  blocksMade                UserBlock[]                   @relation("BlockBy")
  blocksReceived            UserBlock[]                   @relation("BlockedUser")

  @@index([status])
  @@map("users")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// One row per sign-in (a refresh-token family). Access tokens carry the
/// session id, so revoking a session also invalidates its access tokens.
model AuthSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String?   @map("device_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  /// Faz 1-5 sessions only. New sessions store `ipHash` instead (Faz 6,
  /// docs/adr/0024): an HMAC is enough to spot "same network" without
  /// keeping the address itself.
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  /// HMAC-SHA256 of the client IP (keyed, not reversible without the key).
  ipHash        String?   @map("ip_hash") @db.Char(64)
  /// Staff sessions get a shorter lifetime and an idle timeout (Faz 6).
  isAdmin       Boolean   @default(false) @map("is_admin")
  /// Absolute lifetime; rotation never extends past this.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT, LOGOUT_ALL, TOKEN_REUSE, ADMIN, PASSWORD_CHANGE...
  revokedReason String?   @map("revoked_reason") @db.VarChar(40)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Refresh tokens are opaque random strings; only their SHA-256 hash is
/// stored. Each refresh consumes the token and issues a new one. Presenting
/// an already consumed token revokes the whole session (reuse detection).
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Why a one-time code was sent. PASSWORD_RESET etc. can be added later.
enum OtpPurpose {
  /// Phone sign-in; creates a CUSTOMER account on first use.
  REGISTER_OR_LOGIN
  /// A signed-in user proving they own a phone number.
  VERIFY_PHONE
}

/// One SMS one-time code (ADR-0009). Only an HMAC of the code is stored.
/// A new request for the same phone and purpose invalidates the previous
/// challenge, so at most one challenge per phone and purpose is open.
model OtpChallenge {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// E.164.
  phone         String     @db.VarChar(20)
  purpose       OtpPurpose
  /// Set for VERIFY_PHONE: the signed-in user who asked for the code.
  userId        String?    @map("user_id") @db.Uuid
  /// HMAC-SHA256(secret, challengeId:code), hex.
  codeHash      String     @map("code_hash") @db.Char(64)
  attempts      Int        @default(0) @db.SmallInt
  maxAttempts   Int        @map("max_attempts") @db.SmallInt
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime?  @map("consumed_at") @db.Timestamptz(3)
  /// Replaced by a newer code or locked after too many wrong attempts.
  invalidatedAt DateTime?  @map("invalidated_at") @db.Timestamptz(3)
  ipAddress     String?    @map("ip_address") @db.VarChar(64)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([phone, purpose], map: "otp_challenges_open_phone_purpose_key", where: raw("consumed_at IS NULL AND invalidated_at IS NULL"))
  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum PushProvider {
  EXPO
  FCM
  APNS
}

model Device {
  id                     String         @id @default(uuid(7)) @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  platform               DevicePlatform
  pushProvider           PushProvider?  @map("push_provider")
  /// A push token belongs to one device install; re-registering moves it.
  pushToken              String?        @unique @map("push_token") @db.VarChar(512)
  deviceName             String?        @map("device_name") @db.VarChar(120)
  appVersion             String?        @map("app_version") @db.VarChar(40)
  lastSeenAt             DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt              DateTime?      @map("revoked_at") @db.Timestamptz(3)
  /// Set when the push service reported the token dead (DeviceNotRegistered);
  /// the token itself is cleared so nothing is sent to it again.
  pushTokenInvalidatedAt DateTime?      @map("push_token_invalidated_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    AuthSession[]
  pushTickets PushTicket[]

  @@index([userId])
  @@map("devices")
}

// ============================================================================
// Location (Turkey-wide: 81 il, ilçe)
// ============================================================================

/// Official province (il). `id` is the plate code, 1-81.
model Province {
  id           Int      @id @db.SmallInt
  name         String   @unique @db.VarChar(60)
  slug         String   @unique @db.VarChar(60)
  /// Marketplace open in this province (pilot cities first).
  isActive     Boolean  @default(false) @map("is_active")
  /// Faz 7 (docs/adr/0029): ISO 3166-1 alpha-2; Türkiye is the first country.
  countryCode  String   @default("TR") @map("country_code") @db.Char(2)
  /// While closed (`isActive` false): true = WAITLIST (customers may still
  /// post a request, it waits for supply), false = DISABLED.
  waitlistOpen Boolean  @default(true) @map("waitlist_open")
  /// Approximate centre (the provincial capital), WGS84. Reference data.
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  country         Country                 @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  districts       District[]
  addresses       Address[]
  serviceRequests ServiceRequest[]
  categoryRules   ProvinceCategory[]
  serviceRegions  ProviderServiceRegion[]
  marketEvents    MarketplaceEvent[]

  @@index([countryCode])
  @@map("provinces")
}

/// Faz 7: countries the data model can hold. Only TR is active.
model Country {
  code      String   @id @db.Char(2)
  name      String   @db.VarChar(80)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  provinces Province[]

  @@map("countries")
}

model District {
  id               String   @id @default(uuid(7)) @db.Uuid
  provinceId       Int      @map("province_id") @db.SmallInt
  name             String   @db.VarChar(80)
  slug             String   @db.VarChar(80)
  isActive         Boolean  @default(true) @map("is_active")
  /// Faz 7: approximate centre of the district (its seat), WGS84, from the
  /// GeoNames gazetteer (docs/reference-data/turkey-locations.md). Used for
  /// approximate distances only, never shown as anyone's location.
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  /// DISTRICT_SEAT | DISTRICT_AREA_MEAN | PROVINCE_CENTER (fallback).
  coordinateSource String?  @map("coordinate_source") @db.VarChar(24)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  province        Province                @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  addresses       Address[]
  serviceRequests ServiceRequest[]
  providerAreas   ProviderServiceArea[]
  regionCenters   ProviderServiceRegion[]
  serviceCenters  ProviderProfile[]       @relation("ProviderServiceCenter")
  marketEvents    MarketplaceEvent[]

  @@unique([provinceId, slug])
  @@map("districts")
}

/// Per-province switch for a category (e.g. Çilingir NOW open in İstanbul
/// but not yet in Ankara). Missing row = follow the category's defaults.
model ProvinceCategory {
  provinceId Int      @map("province_id") @db.SmallInt
  categoryId String   @map("category_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  nowEnabled Boolean  @default(false) @map("now_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  province Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([provinceId, categoryId])
  @@map("province_categories")
}

model Address {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  label        String?   @db.VarChar(40)
  provinceId   Int       @map("province_id") @db.SmallInt
  districtId   String    @map("district_id") @db.Uuid
  neighborhood String?   @db.VarChar(120)
  addressLine  String    @map("address_line") @db.VarChar(300)
  buildingNo   String?   @map("building_no") @db.VarChar(20)
  apartmentNo  String?   @map("apartment_no") @db.VarChar(20)
  postalCode   String?   @map("postal_code") @db.VarChar(10)
  /// Directions for the provider ("Kapı kodu 1234, arka giriş").
  instructions String?   @db.VarChar(500)
  /// WGS84. Both or neither (DB check). PostGIS can replace these later.
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  province        Province         @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district        District         @relation(fields: [districtId], references: [id], onDelete: Restrict)
  serviceRequests ServiceRequest[]

  /// At most one live default address per user.
  @@unique([userId], map: "addresses_one_default_per_user_key", where: raw("is_default AND deleted_at IS NULL"))
  @@index([userId, deletedAt])
  @@map("addresses")
}

// ============================================================================
// Customer and provider profiles
// ============================================================================

model CustomerProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  jobs            Job[]
  favorites       FavoriteProvider[]
  conversations   Conversation[]

  @@map("customer_profiles")
}

enum ProviderStatus {
  /// Profile opened, onboarding not finished. Not listed.
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

model ProviderProfile {
  id                      String                @id @default(uuid(7)) @db.Uuid
  userId                  String                @unique @map("user_id") @db.Uuid
  type                    ProviderType          @default(INDIVIDUAL)
  status                  ProviderStatus        @default(DRAFT)
  displayName             String                @map("display_name") @db.VarChar(120)
  bio                     String?               @db.VarChar(2000)
  yearsOfExperience       Int?                  @map("years_of_experience") @db.SmallInt
  /// Provider opted in to UstaGO NOW (emergency) jobs.
  nowEnabled              Boolean               @default(false) @map("now_enabled")
  /// Currently accepting NOW jobs ("müsaitim" toggle).
  isAvailableNow          Boolean               @default(false) @map("is_available_now")
  lastLatitude            Decimal?              @map("last_latitude") @db.Decimal(9, 6)
  lastLongitude           Decimal?              @map("last_longitude") @db.Decimal(9, 6)
  lastLocationAt          DateTime?             @map("last_location_at") @db.Timestamptz(3)
  approvedAt              DateTime?             @map("approved_at") @db.Timestamptz(3)
  /// Last time the application went to PENDING_REVIEW.
  submittedAt             DateTime?             @map("submitted_at") @db.Timestamptz(3)
  /// Last admin decision (approve, reject, suspend, reinstate).
  reviewedAt              DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  reviewedById            String?               @map("reviewed_by_id") @db.Uuid
  /// Shown to the provider while REJECTED or SUSPENDED (DB check).
  statusReason            String?               @map("status_reason") @db.VarChar(1000)
  /// Product access (Faz 6, docs/adr/0023), separate from the application
  /// status above and from verification. Changed only through
  /// provider_suspensions by SuspensionsService.
  accountStatus           ProviderAccountStatus @default(ACTIVE) @map("account_status")
  accountStatusChangedAt  DateTime?             @map("account_status_changed_at") @db.Timestamptz(3)
  /// Faz 7 availability (docs/adr/0031), separate from account status:
  /// "Yeni iş alma" switch. False = no new dispatch, NOW or matching.
  acceptingNewJobs        Boolean               @default(true) @map("accepting_new_jobs")
  /// "Bugün müsait değilim": no new dispatch until this instant.
  unavailableUntil        DateTime?             @map("unavailable_until") @db.Timestamptz(3)
  /// Maximum travel distance (km) from the service centre; null = no limit
  /// beyond the service areas.
  maxTravelKm             Int?                  @map("max_travel_km") @db.SmallInt
  /// "Hizmet merkezi": a district, never a home address (docs/adr/0029).
  serviceCenterDistrictId String?               @map("service_center_district_id") @db.Uuid
  /// Private-storage key of the profile photo (served by signed URL).
  photoStorageKey         String?               @map("photo_storage_key") @db.VarChar(512)
  /// Last provider action in the app (quote, job step, availability).
  lastActiveAt            DateTime?             @map("last_active_at") @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?             @map("deleted_at") @db.Timestamptz(3)

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?                       @relation("ProviderReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  services           ProviderService[]
  serviceAreas       ProviderServiceArea[]
  verifications      ProviderVerification[]
  score              ProviderScore?
  quotes             Quote[]
  jobs               Job[]
  dispatchOffers     EmergencyDispatchOffer[]
  ledgerAccounts     LedgerAccount[]
  payments           Payment[]                   @relation("PaymentProvider")
  earnings           ProviderEarning[]
  cashSettlements    CashSettlement[]
  payoutDestinations PayoutDestination[]
  payouts            Payout[]
  ledgerTransactions LedgerTransaction[]         @relation("LedgerTransactionProvider")
  verificationCase   ProviderVerificationCase?
  verificationEvents ProviderVerificationEvent[]
  suspensions        ProviderSuspension[]
  // Faz 7
  serviceCenter      District?                   @relation("ProviderServiceCenter", fields: [serviceCenterDistrictId], references: [id], onDelete: SetNull)
  serviceRegions     ProviderServiceRegion[]
  weeklyHours        ProviderWeeklyHours[]
  timeOff            ProviderTimeOff[]
  portfolioItems     ProviderPortfolioItem[]
  favoritedBy        FavoriteProvider[]
  dispatches         RequestDispatch[]
  preferredRequests  ServiceRequest[]            @relation("PreferredProvider")
  conversations      Conversation[]

  @@index([status, nowEnabled, isAvailableNow])
  @@index([status, submittedAt])
  @@map("provider_profiles")
}

model ProviderService {
  providerId String   @map("provider_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("provider_services")
}

model ProviderServiceArea {
  providerId String   @map("provider_id") @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  district District        @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@id([providerId, districtId])
  @@index([districtId])
  @@map("provider_service_areas")
}

// ============================================================================
// Faz 7: service regions, availability, portfolio (docs/adr/0028-0031)
// ============================================================================

enum ProviderRegionKind {
  /// Every district of the province.
  PROVINCE
  /// Within `radiusKm` of a centre district (never a home address).
  RADIUS
}

/// Service areas wider than one district (district rows stay in
/// provider_service_areas). A request is covered when its district is in
/// provider_service_areas, or its province has an active PROVINCE region,
/// or its approximate point is within an active RADIUS region.
model ProviderServiceRegion {
  id               String             @id @default(uuid(7)) @db.Uuid
  providerId       String             @map("provider_id") @db.Uuid
  kind             ProviderRegionKind
  provinceId       Int                @map("province_id") @db.SmallInt
  /// RADIUS only: the centre district; its reference centre is copied below.
  centerDistrictId String?            @map("center_district_id") @db.Uuid
  radiusKm         Int?               @map("radius_km") @db.SmallInt
  centerLat        Decimal?           @map("center_lat") @db.Decimal(9, 6)
  centerLng        Decimal?           @map("center_lng") @db.Decimal(9, 6)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  province       Province        @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  centerDistrict District?       @relation(fields: [centerDistrictId], references: [id], onDelete: Restrict)

  /// One live PROVINCE region per provider and province.
  @@unique([providerId, provinceId], map: "provider_service_regions_one_province_key", where: raw("kind = 'PROVINCE' AND active"))
  @@index([providerId, active])
  @@index([provinceId, kind, active])
  @@map("provider_service_regions")
}

/// Weekly working hours in the marketplace time zone (Europe/Istanbul),
/// minutes from local midnight. Several intervals per day are allowed.
/// No rows at all = hours not set (the provider is treated as flexible).
model ProviderWeeklyHours {
  id          String   @id @default(uuid(7)) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  /// ISO weekday: 1 = Pazartesi ... 7 = Pazar.
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, weekday, startMinute])
  @@map("provider_weekly_hours")
}

/// "İzindeyim": no new dispatch, matching or NOW between startsAt and
/// endsAt. Existing jobs are never touched.
model ProviderTimeOff {
  id          String    @id @default(uuid(7)) @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  note        String?   @db.VarChar(200)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, endsAt])
  @@map("provider_time_off")
}

/// A piece of past work shown on the public profile.
model ProviderPortfolioItem {
  id                 String    @id @default(uuid(7)) @db.Uuid
  providerId         String    @map("provider_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  title              String    @db.VarChar(120)
  description        String?   @db.VarChar(1000)
  sortOrder          Int       @default(0) @map("sort_order")
  /// The provider confirmed the photos show no customer faces, addresses
  /// or documents and that they may publish them.
  consentConfirmedAt DateTime  @map("consent_confirmed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  provider ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media    PortfolioMedia[]

  @@index([providerId, deletedAt, sortOrder])
  @@map("provider_portfolio_items")
}

/// Photos of a portfolio item. Video is architecture-ready (`kind`) but not
/// accepted in this phase (no transcoding).
model PortfolioMedia {
  id             String   @id @default(uuid(7)) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  uploadIntentId String   @unique @map("upload_intent_id") @db.Uuid
  storageKey     String   @unique @map("storage_key") @db.VarChar(512)
  kind           String   @default("IMAGE") @db.VarChar(10)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      Int      @map("size_bytes")
  sortOrder      Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item         ProviderPortfolioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadIntent UploadIntent          @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)

  @@index([itemId, sortOrder])
  @@map("portfolio_media")
}

/// A customer's saved provider. Private to the customer: providers never
/// see who saved them.
model FavoriteProvider {
  customerId String   @map("customer_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([customerId, providerId])
  @@index([customerId, createdAt])
  @@map("favorite_providers")
}

enum VerificationType {
  IDENTITY
  PROFESSIONAL_CERTIFICATE
  TAX_REGISTRATION
  BUSINESS_LICENSE
  CRIMINAL_RECORD
  /// Faz 6: generic business paper (vergi levhası, oda kaydı...).
  BUSINESS_DOCUMENT
  OTHER
}

/// Result of the malware scanner (docs/adr/0023). Without a real scanner
/// every file stays NOT_SCANNED; SAFE is only ever written by a real scan.
enum DocumentScanStatus {
  NOT_SCANNED
  SAFE
  REJECTED
  QUARANTINED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ProviderVerification {
  id               String             @id @default(uuid(7)) @db.Uuid
  providerId       String             @map("provider_id") @db.Uuid
  type             VerificationType
  status           VerificationStatus @default(PENDING)
  /// Private object-storage key; files are served only via signed URLs.
  documentKey      String?            @map("document_key") @db.VarChar(512)
  /// Detected from the file's magic bytes, not the client's claim.
  mimeType         String?            @map("mime_type") @db.VarChar(100)
  sizeBytes        Int?               @map("size_bytes")
  /// Display only (sanitised basename); never used as a storage path.
  originalFileName String?            @map("original_file_name") @db.VarChar(255)
  submittedAt      DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById     String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason  String?            @map("rejection_reason") @db.VarChar(500)
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(3)
  /// Faz 6: the verification case this document was submitted with.
  caseId           String?            @map("case_id") @db.Uuid
  /// SHA-256 of the stored bytes: duplicate detection and tamper evidence.
  sha256           String?            @db.Char(64)
  scanStatus       DocumentScanStatus @default(NOT_SCANNED) @map("scan_status")
  scannedAt        DateTime?          @map("scanned_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider   ProviderProfile           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedBy User?                     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  case       ProviderVerificationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  /// One open (PENDING) submission per provider and type.
  @@unique([providerId, type], map: "provider_verifications_one_pending_key", where: raw("status = 'PENDING'"))
  @@index([providerId, type])
  @@index([status, submittedAt])
  @@index([caseId])
  @@index([providerId, sha256])
  @@map("provider_verifications")
}

enum UploadPurpose {
  PROVIDER_VERIFICATION
  /// Optional JPEG/PNG photos a customer attaches to a service request.
  SERVICE_REQUEST_PHOTO
  /// Faz 7: portfolio photos, chat photos and provider profile photos.
  PORTFOLIO_IMAGE
  CHAT_IMAGE
  PROFILE_PHOTO
}

/// A signed upload slot handed to a client (ADR-0010). The client uploads
/// straight to object storage, then finalises by referencing the intent.
/// Unconsumed intents expire; their objects are garbage.
model UploadIntent {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  purpose          UploadPurpose
  /// Server-generated random key; never derived from the file name.
  storageKey       String        @unique @map("storage_key") @db.VarChar(512)
  declaredMimeType String        @map("declared_mime_type") @db.VarChar(100)
  declaredSize     Int           @map("declared_size")
  maxSizeBytes     Int           @map("max_size_bytes")
  originalFileName String?       @map("original_file_name") @db.VarChar(255)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime?     @map("consumed_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequestPhoto ServiceRequestPhoto?
  portfolioMedia      PortfolioMedia?
  message             Message?

  @@index([userId, createdAt])
  @@map("upload_intents")
}

/// Latest computed UstaScore. Inputs are TrustEvents and reviews; paid plans
/// are never an input (organic ranking cannot be bought, ADR-0008).
model ProviderScore {
  providerId       String   @id @map("provider_id") @db.Uuid
  /// 0.00-100.00.
  score            Decimal  @db.Decimal(5, 2)
  /// Number of completed jobs the score is based on.
  sampleSize       Int      @default(0) @map("sample_size")
  /// Cold start: new providers get a bounded exposure boost instead of
  /// being invisible until they collect reviews.
  isNewProvider    Boolean  @default(true) @map("is_new_provider")
  /// Signal breakdown used for the score, for transparency and appeals.
  components       Json     @default("{}")
  algorithmVersion String   @map("algorithm_version") @db.VarChar(20)
  computedAt       DateTime @map("computed_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("provider_scores")
}

// ============================================================================
// Catalog
// ============================================================================

model ServiceCategory {
  id                 String             @id @default(uuid(7)) @db.Uuid
  parentId           String?            @map("parent_id") @db.Uuid
  slug               String             @unique @db.VarChar(80)
  name               String             @db.VarChar(80)
  description        String?            @db.VarChar(500)
  icon               String?            @db.VarChar(60)
  sortOrder          Int                @default(0) @map("sort_order")
  isActive           Boolean            @default(true) @map("is_active")
  /// Category can be requested as UstaGO NOW (emergency).
  supportsNow        Boolean            @default(false) @map("supports_now")
  /// Category can be requested through "Teklif Al".
  supportsQuote      Boolean            @default(true) @map("supports_quote")
  /// Faz 7: how the request wizard treats photos for this category.
  requestPhotoPolicy RequestPhotoPolicy @default(OPTIONAL) @map("request_photo_policy")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          ServiceCategory?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        ServiceCategory[]             @relation("CategoryTree")
  provinceRules   ProvinceCategory[]
  providers       ProviderService[]
  serviceRequests ServiceRequest[]
  jobs            Job[]
  requirements    CategoryProviderRequirement[]
  aliases         CategoryAlias[]
  questions       CategoryQuestion[]
  portfolioItems  ProviderPortfolioItem[]
  marketEvents    MarketplaceEvent[]

  @@index([parentId, sortOrder])
  @@map("service_categories")
}

enum RequestPhotoPolicy {
  OPTIONAL
  RECOMMENDED
  REQUIRED
}

/// Search synonym ("elektrikçi", "elektrik ustası" → Elektrik). `normalized`
/// is the Turkish-folded form used for lookup; unique across categories.
model CategoryAlias {
  id         String   @id @default(uuid(7)) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  alias      String   @db.VarChar(80)
  normalized String   @unique @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_aliases")
}

enum CategoryQuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  SHORT_TEXT
  NUMBER
}

/// Admin-defined extra question of a category's request form. A published
/// request keeps a snapshot of the question text and its answer
/// (service_requests.answers), so editing a question never changes history.
model CategoryQuestion {
  id         String               @id @default(uuid(7)) @db.Uuid
  categoryId String               @map("category_id") @db.Uuid
  /// Stable machine key within the category ("power_out").
  key        String               @db.VarChar(40)
  label      String               @db.VarChar(200)
  helpText   String?              @map("help_text") @db.VarChar(300)
  type       CategoryQuestionType
  /// SELECT types: [{ "value": "full", "label": "Tamamen" }, ...].
  options    Json?
  required   Boolean              @default(false)
  minValue   Int?                 @map("min_value")
  maxValue   Int?                 @map("max_value")
  sortOrder  Int                  @default(0) @map("sort_order")
  isActive   Boolean              @default(true) @map("is_active")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
  @@map("category_questions")
}

// ============================================================================
// Service requests, NOW dispatch, quotes and negotiation
// ============================================================================

enum ServiceRequestType {
  /// UstaGO NOW / Acil Usta.
  NOW
  /// Teklif Al.
  QUOTE
}

enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  MATCHING
  QUOTED
  MATCHED
  CANCELLED
  EXPIRED
  COMPLETED
}

/// Lifecycle (docs/adr/0014): DRAFT → PUBLISHED (QUOTE) / MATCHING (NOW)
/// → QUOTED (first quote) → MATCHED (a quote accepted, job created) →
/// COMPLETED. CANCELLED and EXPIRED end an open request. Transitions live
/// in service-requests/domain/service-request-lifecycle.ts only.
model ServiceRequest {
  id                  String               @id @default(uuid(7)) @db.Uuid
  customerId          String               @map("customer_id") @db.Uuid
  categoryId          String               @map("category_id") @db.Uuid
  addressId           String               @map("address_id") @db.Uuid
  /// Denormalised from the address for regional search.
  provinceId          Int                  @map("province_id") @db.SmallInt
  districtId          String               @map("district_id") @db.Uuid
  type                ServiceRequestType
  status              ServiceRequestStatus @default(DRAFT)
  title               String               @db.VarChar(140)
  description         String               @db.VarChar(4000)
  /// Customer's expectation only; never binds a provider's quote.
  /// Null = "Bütçem belli değil / teklif almak istiyorum".
  budgetMinor         BigInt?              @map("budget_minor")
  currency            CurrencyCode         @default(TRY)
  preferredStartAt    DateTime?            @map("preferred_start_at") @db.Timestamptz(3)
  preferredEndAt      DateTime?            @map("preferred_end_at") @db.Timestamptz(3)
  publishedAt         DateTime?            @map("published_at") @db.Timestamptz(3)
  expiresAt           DateTime?            @map("expires_at") @db.Timestamptz(3)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelReason        String?              @map("cancel_reason") @db.VarChar(500)
  /// Client-generated key: retrying "create" (double tap, flaky network)
  /// returns the request created the first time instead of a duplicate.
  idempotencyKey      String?              @map("idempotency_key") @db.Uuid
  // Faz 7 (docs/adr/0028, 0029)
  /// Upper end when the customer gave a range ("₺1.500–₺2.000").
  budgetMaxMinor      BigInt?              @map("budget_max_minor")
  /// NOW | TODAY | TOMORROW | DATE: what the customer picked in "Ne zaman?".
  scheduleOption      String?              @map("schedule_option") @db.VarChar(10)
  /// Snapshot of the category questions and answers at publication.
  answers             Json?
  /// Approximate point (district centre or address rounded to ~1 km).
  /// Never the exact address; used for distances.
  approxLatitude      Decimal?             @map("approx_latitude") @db.Decimal(8, 4)
  approxLongitude     Decimal?             @map("approx_longitude") @db.Decimal(8, 4)
  /// "Bu ustayı tekrar çağır" / "Bu ustadan teklif iste".
  preferredProviderId String?              @map("preferred_provider_id") @db.Uuid
  /// True: only the preferred provider sees it until the customer widens it.
  preferredOnly       Boolean              @default(false) @map("preferred_only")
  rehireOfJobId       String?              @map("rehire_of_job_id") @db.Uuid
  /// Dispatch waves sent so far (0 = none yet) and when the next is due.
  dispatchWave        Int                  @default(0) @map("dispatch_wave") @db.SmallInt
  lastDispatchedAt    DateTime?            @map("last_dispatched_at") @db.Timestamptz(3)
  nextDispatchAt      DateTime?            @map("next_dispatch_at") @db.Timestamptz(3)
  /// When the "no offer yet" prompt was raised for the customer.
  noOfferAlertedAt    DateTime?            @map("no_offer_alerted_at") @db.Timestamptz(3)
  version             Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  preferredProvider ProviderProfile?         @relation("PreferredProvider", fields: [preferredProviderId], references: [id], onDelete: SetNull)
  rehireOfJob       Job?                     @relation("RehireOf", fields: [rehireOfJobId], references: [id], onDelete: SetNull)
  dispatches        RequestDispatch[]
  conversations     Conversation[]
  marketEvents      MarketplaceEvent[]
  customer          CustomerProfile          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category          ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address           Address                  @relation(fields: [addressId], references: [id], onDelete: Restrict)
  province          Province                 @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district          District                 @relation(fields: [districtId], references: [id], onDelete: Restrict)
  quotes            Quote[]
  dispatchOffers    EmergencyDispatchOffer[]
  job               Job?
  photos            ServiceRequestPhoto[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@index([status, type, provinceId, categoryId])
  /// Provider opportunity feed: requests in the provider's districts.
  @@index([districtId, categoryId, status])
  @@index([createdAt])
  @@index([nextDispatchAt])
  @@index([preferredProviderId])
  @@map("service_requests")
}

/// A photo the customer attached to a request. The file lives in private
/// object storage and is only reachable through a short-lived signed URL.
model ServiceRequestPhoto {
  id               String   @id @default(uuid(7)) @db.Uuid
  serviceRequestId String   @map("service_request_id") @db.Uuid
  /// The consumed upload; unique so one upload backs at most one photo.
  uploadIntentId   String   @unique @map("upload_intent_id") @db.Uuid
  storageKey       String   @unique @map("storage_key") @db.VarChar(512)
  /// Detected from magic bytes (JPEG or PNG).
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        Int      @map("size_bytes")
  sortOrder        Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  uploadIntent   UploadIntent   @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, sortOrder])
  @@map("service_request_photos")
}

enum DispatchOfferStatus {
  SENT
  SEEN
  ACCEPTED
  DECLINED
  /// Another provider accepted first, or the customer cancelled.
  SUPERSEDED
  EXPIRED
}

/// One row per provider notified about a NOW request. The first ACCEPTED
/// row wins; the unique Job.serviceRequestId makes a double accept fail.
model EmergencyDispatchOffer {
  id               String              @id @default(uuid(7)) @db.Uuid
  serviceRequestId String              @map("service_request_id") @db.Uuid
  providerId       String              @map("provider_id") @db.Uuid
  status           DispatchOfferStatus @default(SENT)
  /// Distance at dispatch time, for ranking and analytics.
  distanceMeters   Int?                @map("distance_meters")
  sentAt           DateTime            @default(now()) @map("sent_at") @db.Timestamptz(3)
  respondedAt      DateTime?           @map("responded_at") @db.Timestamptz(3)
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, providerId])
  @@index([providerId, status])
  @@map("emergency_dispatch_offers")
}

enum DispatchNotifyMode {
  /// In-app row and a push.
  PUSH
  /// In-app row only (provider chose "sessiz" or it was quiet hours).
  IN_APP
  /// No notification (provider turned new-job alerts off); still listed.
  NONE
}

enum DispatchResult {
  PENDING
  QUOTED
  /// The request closed (matched elsewhere, cancelled, expired).
  CLOSED
}

/// Faz 7 (docs/adr/0028): one row per provider a request was dispatched to,
/// for both QUOTE and NOW. Unique per (request, provider): a later wave never
/// notifies the same provider twice.
model RequestDispatch {
  id               String             @id @default(uuid(7)) @db.Uuid
  serviceRequestId String             @map("service_request_id") @db.Uuid
  providerId       String             @map("provider_id") @db.Uuid
  wave             Int                @db.SmallInt
  /// Ranking algorithm that produced the score ("MATCH_V1").
  algorithmVersion String             @map("algorithm_version") @db.VarChar(20)
  matchScore       Decimal            @map("match_score") @db.Decimal(5, 2)
  /// Explainable breakdown (internal; admin/debug only).
  scoreBreakdown   Json               @map("score_breakdown")
  /// Approximate (straight-line) distance, km.
  distanceKm       Decimal?           @map("distance_km") @db.Decimal(6, 1)
  isPreferred      Boolean            @default(false) @map("is_preferred")
  notifyMode       DispatchNotifyMode @map("notify_mode")
  dispatchedAt     DateTime           @default(now()) @map("dispatched_at") @db.Timestamptz(3)
  viewedAt         DateTime?          @map("viewed_at") @db.Timestamptz(3)
  respondedAt      DateTime?          @map("responded_at") @db.Timestamptz(3)
  result           DispatchResult     @default(PENDING)

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, providerId])
  @@index([serviceRequestId, wave])
  @@index([providerId, dispatchedAt])
  @@map("request_dispatches")
}

enum QuoteStatus {
  /// Waiting for the customer to answer the provider's latest offer.
  PENDING_CUSTOMER
  /// Waiting for the provider to answer the customer's counter offer.
  PENDING_PROVIDER
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// One negotiation thread between a provider and a service request. Every
/// price change is a new QuoteRevision; nothing is overwritten.
model Quote {
  id                 String       @id @default(uuid(7)) @db.Uuid
  serviceRequestId   String       @map("service_request_id") @db.Uuid
  providerId         String       @map("provider_id") @db.Uuid
  status             QuoteStatus  @default(PENDING_CUSTOMER)
  currency           CurrencyCode @default(TRY)
  /// Set when the thread is accepted; points at the accepted revision.
  acceptedRevisionId String?      @unique @map("accepted_revision_id") @db.Uuid
  acceptedAt         DateTime?    @map("accepted_at") @db.Timestamptz(3)
  version            Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  provider         ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  revisions        QuoteRevision[] @relation("QuoteRevisions")
  acceptedRevision QuoteRevision?  @relation("AcceptedRevision", fields: [acceptedRevisionId], references: [id], onDelete: Restrict)
  job              Job?

  @@unique([serviceRequestId, providerId])
  /// At most one accepted quote per request, whatever the application does.
  @@unique([serviceRequestId], map: "quotes_one_accepted_per_request_key", where: raw("status = 'ACCEPTED'"))
  @@index([serviceRequestId, status])
  @@index([providerId, status])
  @@map("quotes")
}

/// "Ne zaman gelebilirim": chosen by the provider, never computed.
enum QuoteEta {
  MIN_30
  HOUR_1
  HOUR_2
  TODAY
  TOMORROW
  CUSTOM
}

enum QuoteRevisionKind {
  /// Provider's first offer.
  OFFER
  /// Customer's counter offer.
  CUSTOMER_COUNTER
  /// Provider's revised or counter offer.
  PROVIDER_COUNTER
}

/// Immutable. Revision 1 is always the provider's OFFER.
model QuoteRevision {
  id                       String            @id @default(uuid(7)) @db.Uuid
  quoteId                  String            @map("quote_id") @db.Uuid
  revisionNo               Int               @map("revision_no")
  kind                     QuoteRevisionKind
  authorUserId             String            @map("author_user_id") @db.Uuid
  totalMinor               BigInt            @map("total_minor")
  laborMinor               BigInt?           @map("labor_minor")
  materialMinor            BigInt?           @map("material_minor")
  materialsIncluded        Boolean?          @map("materials_included")
  /// Faz 7 optional breakdown lines; the total stays the only binding amount.
  serviceMinor             BigInt?           @map("service_minor")
  otherMinor               BigInt?           @map("other_minor")
  /// Provider's own arrival estimate (no routing API, docs/adr/0029).
  arrivalEta               QuoteEta?         @map("arrival_eta")
  currency                 CurrencyCode      @default(TRY)
  note                     String?           @db.VarChar(2000)
  estimatedDurationMinutes Int?              @map("estimated_duration_minutes")
  availableFrom            DateTime?         @map("available_from") @db.Timestamptz(3)
  availableUntil           DateTime?         @map("available_until") @db.Timestamptz(3)
  validUntil               DateTime?         @map("valid_until") @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  quote         Quote  @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Cascade)
  author        User   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  acceptedQuote Quote? @relation("AcceptedRevision")
  jobs          Job[]

  @@unique([quoteId, revisionNo])
  @@map("quote_revisions")
}

// ============================================================================
// Jobs (a booking and its execution), status history and change orders
// ============================================================================

enum JobStatus {
  CREATED
  CONFIRMED
  PROVIDER_PREPARING
  PROVIDER_EN_ROUTE
  PROVIDER_ARRIVED
  IN_PROGRESS
  AWAITING_COMPLETION_CONFIRMATION
  COMPLETED
  DISPUTED
  CANCELLED
}

/// Who performed an action on a job.
enum JobActor {
  CUSTOMER
  PROVIDER
  ADMIN
  SYSTEM
}

enum PaymentMethod {
  IN_APP
  CASH
  BANK_TRANSFER
}

/// Created when a quote is accepted or a NOW offer is accepted. Booking and
/// job are one aggregate (ADR-0008): scheduling fields live here.
model Job {
  id                    String         @id @default(uuid(7)) @db.Uuid
  /// Unique: one job per request, so two accepts cannot both succeed.
  serviceRequestId      String         @unique @map("service_request_id") @db.Uuid
  quoteId               String?        @unique @map("quote_id") @db.Uuid
  acceptedRevisionId    String?        @map("accepted_revision_id") @db.Uuid
  customerId            String         @map("customer_id") @db.Uuid
  providerId            String         @map("provider_id") @db.Uuid
  categoryId            String         @map("category_id") @db.Uuid
  status                JobStatus      @default(CREATED)
  /// AGREED_PRICE: locked when the job is created and never updated.
  agreedPriceMinor      BigInt         @map("agreed_price_minor")
  /// agreedPriceMinor + accepted change orders. Changes only through an
  /// accepted ChangeOrder, in the same transaction.
  currentTotalMinor     BigInt         @map("current_total_minor")
  currency              CurrencyCode   @default(TRY)
  /// Chosen by the customer (IN_APP = "Uygulamadan öde", CASH = "Ustaya
  /// doğrudan öde"). Payment lifecycle is separate from the job lifecycle.
  paymentMethod         PaymentMethod? @map("payment_method")
  /// Fee policy snapshot taken when the deal was made (docs/adr/0020): a
  /// later rate change never affects this job. Null for jobs created
  /// before Faz 5; filled on their first financial event.
  platformFeePolicyId   String?        @map("platform_fee_policy_id") @db.Uuid
  platformFeeBps        Int?           @map("platform_fee_bps")
  scheduledStartAt      DateTime?      @map("scheduled_start_at") @db.Timestamptz(3)
  /// Step timestamps (docs/adr/0015): written once by the job state
  /// machine, never changed afterwards (a database trigger refuses it).
  enRouteAt             DateTime?      @map("en_route_at") @db.Timestamptz(3)
  arrivedAt             DateTime?      @map("arrived_at") @db.Timestamptz(3)
  startedAt             DateTime?      @map("started_at") @db.Timestamptz(3)
  completionRequestedAt DateTime?      @map("completion_requested_at") @db.Timestamptz(3)
  completedAt           DateTime?      @map("completed_at") @db.Timestamptz(3)
  disputedAt            DateTime?      @map("disputed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?        @map("cancelled_by_id") @db.Uuid
  /// Which side cancelled: only PROVIDER cancellations count against the
  /// provider's quality score (docs/adr/0016).
  cancellationActor     JobActor?      @map("cancellation_actor")
  cancellationReason    String?        @map("cancellation_reason") @db.VarChar(500)
  version               Int            @default(0)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest     ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote              Quote?              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  acceptedRevision   QuoteRevision?      @relation(fields: [acceptedRevisionId], references: [id], onDelete: Restrict)
  customer           CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category           ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cancelledBy        User?               @relation("JobCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  feePolicy          PlatformFeePolicy?  @relation(fields: [platformFeePolicyId], references: [id], onDelete: Restrict)
  statusHistory      JobStatusHistory[]
  changeOrders       ChangeOrder[]
  payments           Payment[]
  reviews            Review[]
  disputes           Dispute[]
  ledgerEntries      LedgerEntry[]
  ledgerTransactions LedgerTransaction[]
  refunds            Refund[]
  earnings           ProviderEarning[]
  cashSettlement     CashSettlement?
  rehires            ServiceRequest[]    @relation("RehireOf")
  conversations      Conversation[]

  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([providerId, status])
  @@index([status])
  @@index([completedAt])
  @@map("jobs")
}

/// Append-only. Written by the job state machine in the same transaction
/// as the status change.
model JobStatusHistory {
  id          String     @id @default(uuid(7)) @db.Uuid
  jobId       String     @map("job_id") @db.Uuid
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  reason      String?    @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@map("job_status_history")
}

enum ChangeOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

/// "Ek 3 metre boru gerekiyor +600 TL". The provider proposes, the customer
/// decides; a rejected change keeps the previous total.
model ChangeOrder {
  id                 String            @id @default(uuid(7)) @db.Uuid
  jobId              String            @map("job_id") @db.Uuid
  requestedById      String            @map("requested_by_id") @db.Uuid
  description        String            @db.VarChar(1000)
  /// Extra work only: always positive (DB check). Removing work would be a
  /// separate, explicit flow.
  amountDeltaMinor   BigInt            @map("amount_delta_minor")
  currency           CurrencyCode      @default(TRY)
  /// Job total when the change was proposed and the total it would become.
  previousTotalMinor BigInt            @map("previous_total_minor")
  proposedTotalMinor BigInt            @map("proposed_total_minor")
  status             ChangeOrderStatus @default(PENDING)
  respondedById      String?           @map("responded_by_id") @db.Uuid
  respondedAt        DateTime?         @map("responded_at") @db.Timestamptz(3)
  version            Int               @default(0)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ChangeOrderRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  respondedBy User? @relation("ChangeOrderRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  /// One open (PENDING) change order per job at a time.
  @@unique([jobId], map: "change_orders_one_pending_per_job_key", where: raw("status = 'PENDING'"))
  @@index([jobId, status])
  @@map("change_orders")
}

// ============================================================================
// Payments, refunds, cash settlements, provider earnings, payouts and the
// double-entry ledger (Faz 5, docs/adr/0018-0020)
// ============================================================================

enum PaymentStatus {
  /// Waiting for a successful attempt (the provider has not confirmed money).
  PENDING
  AUTHORIZED
  /// The payment provider confirmed the money (server-side, never the client).
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
  /// Gave up after the maximum number of failed attempts.
  FAILED
  CANCELLED
  /// Reserved for chargebacks (not used in Faz 5).
  DISPUTED
  /// Reserved (Faz 1). Cash is tracked in `cash_settlements`, not here.
  SETTLED_OFFLINE
}

/// One payment of a job ("Uygulamadan öde"). The amount is always computed
/// by the server from the job's current total minus what is already paid
/// or in flight; clients never send an amount. A job may have several
/// payments: the agreed price and, after an accepted change order, the
/// difference (docs/adr/0019). For IN_APP payments `gateway` names the
/// payment provider adapter ("mock" in development).
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  jobId            String        @map("job_id") @db.Uuid
  payerId          String        @map("payer_id") @db.Uuid
  /// The job's provider, copied for finance queries without a join.
  providerId       String?       @map("provider_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amountMinor      BigInt        @map("amount_minor")
  /// Platform fee assessed on this payment when it succeeded (0 before).
  platformFeeMinor BigInt        @default(0) @map("platform_fee_minor")
  /// Fee rate snapshot (basis points) taken from the job's policy snapshot.
  platformFeeBps   Int?          @map("platform_fee_bps")
  currency         CurrencyCode  @default(TRY)
  gateway          String?       @db.VarChar(40)
  /// Provider id of the successful attempt. Never shown as the payment id.
  gatewayReference String?       @map("gateway_reference") @db.VarChar(120)
  /// Client-supplied key of the request that created it.
  idempotencyKey   String        @unique @map("idempotency_key") @db.VarChar(80)
  lastFailureCode  String?       @map("last_failure_code") @db.VarChar(60)
  succeededAt      DateTime?     @map("succeeded_at") @db.Timestamptz(3)
  failedAt         DateTime?     @map("failed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job                Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payer              User                 @relation(fields: [payerId], references: [id], onDelete: Restrict)
  provider           ProviderProfile?     @relation("PaymentProvider", fields: [providerId], references: [id], onDelete: Restrict)
  transactions       PaymentTransaction[]
  ledgerEntries      LedgerEntry[]
  ledgerTransactions LedgerTransaction[]
  disputes           Dispute[]
  refunds            Refund[]
  earning            ProviderEarning?

  @@unique([gateway, gatewayReference])
  /// At most one payment in flight per job: two taps (or two devices)
  /// can never start two payments for the same amount.
  @@unique([jobId], map: "payments_one_in_flight_per_job_key", where: raw("status = ANY (ARRAY['PENDING'::\"PaymentStatus\", 'AUTHORIZED'::\"PaymentStatus\"])"))
  @@index([jobId])
  @@index([payerId, createdAt])
  @@index([providerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("payments")
}

enum PaymentTransactionType {
  AUTHORIZE
  /// One-step sale attempt (authorise + capture).
  CAPTURE
  VOID
  REFUND
  CHARGEBACK
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// A payment attempt: one call to the payment provider for a payment
/// ("ilk kart reddedildi, ikinci deneme başarılı"). The payment is the
/// financial identity; attempts are the provider-side tries.
model PaymentTransaction {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  paymentId            String                   @map("payment_id") @db.Uuid
  type                 PaymentTransactionType
  status               PaymentTransactionStatus @default(PENDING)
  amountMinor          BigInt                   @map("amount_minor")
  currency             CurrencyCode             @default(TRY)
  gateway              String?                  @db.VarChar(40)
  /// The provider's id for this attempt (webhooks refer to it).
  gatewayTransactionId String?                  @map("gateway_transaction_id") @db.VarChar(120)
  /// Idempotency-Key of the request that started the attempt.
  idempotencyKey       String                   @unique @map("idempotency_key") @db.VarChar(120)
  attemptNumber        Int                      @default(1) @map("attempt_number") @db.SmallInt
  failureCode          String?                  @map("failure_code") @db.VarChar(60)
  completedAt          DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([gateway, gatewayTransactionId])
  @@unique([paymentId, attemptNumber])
  @@index([paymentId])
  @@map("payment_transactions")
}

enum RefundStatus {
  /// Ledger effect recorded, waiting for the payment provider.
  REQUESTED
  SUCCEEDED
  /// The provider refused; the ledger effect was reversed.
  FAILED
}

enum RefundReason {
  JOB_CANCELLED
  DISPUTE_RESOLUTION
  SERVICE_ISSUE
  CUSTOMER_REQUEST
  DUPLICATE_PAYMENT
  OTHER
}

/// A (full or partial) refund of one payment. The amount is checked
/// server-side against what is still refundable, under the payment's row
/// lock; `fee_portion + provider_portion = amount`.
model Refund {
  id                   String       @id @default(uuid(7)) @db.Uuid
  paymentId            String       @map("payment_id") @db.Uuid
  jobId                String       @map("job_id") @db.Uuid
  amountMinor          BigInt       @map("amount_minor")
  /// Part taken back from the platform fee / from the provider's earning.
  feePortionMinor      BigInt       @map("fee_portion_minor")
  providerPortionMinor BigInt       @map("provider_portion_minor")
  currency             CurrencyCode @default(TRY)
  status               RefundStatus @default(REQUESTED)
  reason               RefundReason
  /// Internal note (admin); never shown to the customer verbatim.
  internalNote         String?      @map("internal_note") @db.VarChar(1000)
  /// Null when the system refunds (eligible cancellation).
  requestedById        String?      @map("requested_by_id") @db.Uuid
  gatewayRefundId      String?      @map("gateway_refund_id") @db.VarChar(120)
  idempotencyKey       String       @unique @map("idempotency_key") @db.VarChar(120)
  failureCode          String?      @map("failure_code") @db.VarChar(60)
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  requestedBy        User?               @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  ledgerTransactions LedgerTransaction[]

  @@index([paymentId, status])
  @@index([status, createdAt])
  @@map("refunds")
}

/// Versioned platform fee policy. Rows are never edited: a new rate is a
/// new row with a later `effective_from`. Jobs keep the policy that was
/// in force when the deal was made (jobs.platform_fee_policy_id).
model PlatformFeePolicy {
  id            String       @id @default(uuid(7)) @db.Uuid
  code          String       @unique @db.VarChar(60)
  /// 1500 = %15. 0..10000.
  bps           Int
  fixedFeeMinor BigInt       @default(0) @map("fixed_fee_minor")
  minFeeMinor   BigInt?      @map("min_fee_minor")
  maxFeeMinor   BigInt?      @map("max_fee_minor")
  currency      CurrencyCode @default(TRY)
  effectiveFrom DateTime     @map("effective_from") @db.Timestamptz(3)
  /// True for development/demo policies: not a commercial decision.
  isDevelopment Boolean      @default(false) @map("is_development")
  note          String?      @db.VarChar(500)
  createdById   String?      @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Faz 6 (docs/adr/0025): admin-visible name. Lifecycle: DRAFT until
  /// published; published = SCHEDULED before effective_from, ACTIVE from it
  /// until a later published policy takes over or it is retired. Financial
  /// columns are frozen by a trigger once published_at is set.
  name          String?      @db.VarChar(120)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  publishedById String?      @map("published_by_id") @db.Uuid
  retiredAt     DateTime?    @map("retired_at") @db.Timestamptz(3)
  retiredById   String?      @map("retired_by_id") @db.Uuid

  createdBy   User? @relation("FeePolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User? @relation("FeePolicyPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  retiredBy   User? @relation("FeePolicyRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  jobs        Job[]

  /// Two published, live policies can never start at the same instant for
  /// the same currency and scope: "which one applies" is always one answer.
  @@unique([currency, isDevelopment, effectiveFrom], map: "platform_fee_policies_one_live_per_start_key", where: raw("published_at IS NOT NULL AND retired_at IS NULL"))
  @@index([currency, effectiveFrom])
  @@map("platform_fee_policies")
}

enum ProviderEarningStatus {
  /// Captured; waits for job completion and the hold period.
  PENDING
  /// Frozen by an open dispute; only an admin decision releases it.
  HELD
  /// Released to the provider's available balance.
  AVAILABLE
  /// Fully refunded before release; nothing left to release.
  REVERSED
}

/// What a provider earns from one successful online payment: gross, the
/// platform fee and the net. Amounts are fixed at capture; balances live in
/// the ledger (earnings carry no balance of their own).
model ProviderEarning {
  id         String                @id @default(uuid(7)) @db.Uuid
  providerId String                @map("provider_id") @db.Uuid
  jobId      String                @map("job_id") @db.Uuid
  paymentId  String                @unique @map("payment_id") @db.Uuid
  grossMinor BigInt                @map("gross_minor")
  feeMinor   BigInt                @map("fee_minor")
  netMinor   BigInt                @map("net_minor")
  feeBps     Int                   @map("fee_bps")
  currency   CurrencyCode          @default(TRY)
  status     ProviderEarningStatus @default(PENDING)
  /// Set when the job is completed (and the payment captured): completion
  /// time + FINANCE_EARNING_HOLD_HOURS.
  holdUntil  DateTime?             @map("hold_until") @db.Timestamptz(3)
  releasedAt DateTime?             @map("released_at") @db.Timestamptz(3)
  heldAt     DateTime?             @map("held_at") @db.Timestamptz(3)
  version    Int                   @default(0)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerTransactions LedgerTransaction[]

  @@index([providerId, createdAt])
  @@index([status, holdUntil])
  @@index([jobId])
  @@map("provider_earnings")
}

enum CashSettlementStatus {
  AWAITING_CONFIRMATION
  CUSTOMER_CONFIRMED
  PROVIDER_CONFIRMED
  /// Both sides confirmed (or an admin recorded it after a dispute).
  CONFIRMED
  /// One side says the money did not change hands.
  DISPUTED
  /// Admin recorded that the cash was not paid. UstaGO moves no money.
  RESOLVED_UNPAID
}

/// "Ustaya doğrudan ödeme". UstaGO never holds this money: the record is
/// the two sides' confirmation, and (if the policy says so) the platform
/// fee the provider owes, booked as provider platform debt in the ledger.
model CashSettlement {
  id                  String               @id @default(uuid(7)) @db.Uuid
  jobId               String               @unique @map("job_id") @db.Uuid
  providerId          String               @map("provider_id") @db.Uuid
  amountMinor         BigInt               @map("amount_minor")
  /// Fee the provider owes (0 when cash commission is off).
  feeMinor            BigInt               @default(0) @map("fee_minor")
  feeBps              Int                  @map("fee_bps")
  currency            CurrencyCode         @default(TRY)
  status              CashSettlementStatus @default(AWAITING_CONFIRMATION)
  customerConfirmedAt DateTime?            @map("customer_confirmed_at") @db.Timestamptz(3)
  providerConfirmedAt DateTime?            @map("provider_confirmed_at") @db.Timestamptz(3)
  confirmedAt         DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  disputedAt          DateTime?            @map("disputed_at") @db.Timestamptz(3)
  disputedById        String?              @map("disputed_by_id") @db.Uuid
  disputeNote         String?              @map("dispute_note") @db.VarChar(1000)
  resolvedById        String?              @map("resolved_by_id") @db.Uuid
  resolvedAt          DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolutionNote      String?              @map("resolution_note") @db.VarChar(1000)
  version             Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  disputedBy         User?               @relation("CashDisputedBy", fields: [disputedById], references: [id], onDelete: SetNull)
  resolvedBy         User?               @relation("CashResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  ledgerTransactions LedgerTransaction[]

  @@index([status, createdAt])
  @@index([providerId, createdAt])
  @@map("cash_settlements")
}

enum PayoutDestinationType {
  /// Demo destination: validated IBAN format, only masked digits stored.
  /// Refused in production (docs/adr/0025).
  TEST_BANK_ACCOUNT
  /// A real account held by a payout provider behind a token
  /// (`external_destination_ref`); no adapter exists yet.
  BANK_ACCOUNT
}

/// Faz 6: no bank check exists yet, so a finance admin confirms the
/// account by hand; payouts need VERIFIED (docs/adr/0025).
enum PayoutDestinationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
}

/// Where a provider's payouts go. Faz 5 stores no full IBAN at all: the
/// masked form and the last four digits only. A real provider will hold
/// the account behind a token.
model PayoutDestination {
  id                     String                  @id @default(uuid(7)) @db.Uuid
  providerId             String                  @map("provider_id") @db.Uuid
  type                   PayoutDestinationType   @default(TEST_BANK_ACCOUNT)
  holderName             String                  @map("holder_name") @db.VarChar(120)
  maskedIban             String                  @map("masked_iban") @db.VarChar(40)
  last4                  String                  @db.VarChar(4)
  isTest                 Boolean                 @default(true) @map("is_test")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  deactivatedAt          DateTime?               @map("deactivated_at") @db.Timestamptz(3)
  verificationStatus     PayoutDestinationStatus @default(PENDING_VERIFICATION) @map("verification_status")
  verifiedAt             DateTime?               @map("verified_at") @db.Timestamptz(3)
  verifiedById           String?                 @map("verified_by_id") @db.Uuid
  /// Token/reference a real payout provider returns; never a raw IBAN.
  externalDestinationRef String?                 @map("external_destination_ref") @db.VarChar(120)

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  verifiedBy User?           @relation("PayoutDestinationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  payouts    Payout[]

  @@unique([providerId], map: "payout_destinations_one_active_key", where: raw("deactivated_at IS NULL"))
  @@map("payout_destinations")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
  /// Faz 6: the payout provider's answer was lost (timeout, 5xx). The money
  /// stays reserved until a finance admin checks with the provider and
  /// records PAID or FAILED; nothing is retried or released automatically.
  NEEDS_RECONCILIATION
}

/// A provider's withdrawal request ("Para Çek"). Requesting reserves the
/// amount in the ledger (available → reserved) under a lock on the
/// provider's accounts, so the same money can never be requested twice.
model Payout {
  id               String       @id @default(uuid(7)) @db.Uuid
  providerId       String       @map("provider_id") @db.Uuid
  destinationId    String       @map("destination_id") @db.Uuid
  amountMinor      BigInt       @map("amount_minor")
  currency         CurrencyCode @default(TRY)
  status           PayoutStatus @default(REQUESTED)
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar(120)
  gateway          String?      @db.VarChar(40)
  gatewayReference String?      @map("gateway_reference") @db.VarChar(120)
  failureCode      String?      @map("failure_code") @db.VarChar(60)
  statusNote       String?      @map("status_note") @db.VarChar(500)
  requestedById    String       @map("requested_by_id") @db.Uuid
  decidedById      String?      @map("decided_by_id") @db.Uuid
  approvedAt       DateTime?    @map("approved_at") @db.Timestamptz(3)
  processingAt     DateTime?    @map("processing_at") @db.Timestamptz(3)
  paidAt           DateTime?    @map("paid_at") @db.Timestamptz(3)
  failedAt         DateTime?    @map("failed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  version          Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  destination        PayoutDestination   @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  requestedBy        User                @relation("PayoutRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy          User?               @relation("PayoutDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  ledgerTransactions LedgerTransaction[]

  @@unique([gateway, gatewayReference])
  @@index([providerId, createdAt])
  @@index([status, createdAt])
  @@map("payouts")
}

enum WebhookEventOutcome {
  PROCESSED
  /// Older than what we already know (out of order): state not moved back.
  IGNORED_STALE
  /// Refers to nothing we know.
  IGNORED_UNKNOWN
}

/// Every verified provider webhook, once. The unique key makes a replayed
/// event (same provider event id) a no-op. Payloads are stored redacted.
model WebhookEvent {
  id         String              @id @default(uuid(7)) @db.Uuid
  provider   String              @db.VarChar(40)
  eventId    String              @map("event_id") @db.VarChar(120)
  type       String              @db.VarChar(60)
  outcome    WebhookEventOutcome
  payload    Json
  occurredAt DateTime            @map("occurred_at") @db.Timestamptz(3)
  receivedAt DateTime            @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("processed_webhook_events")
}

enum LedgerAccountType {
  /// Owed to the provider, not yet releasable (job not done / hold / dispute).
  PROVIDER_PENDING
  /// Owed to the provider and withdrawable.
  PROVIDER_AVAILABLE
  /// Owed to the provider, set aside for a requested payout.
  PROVIDER_RESERVED
  /// Money held for the platform at the payment institution.
  PLATFORM_CLEARING
  PLATFORM_FEE_REVENUE
  /// Refunds accepted but not yet confirmed by the payment provider.
  REFUND_LIABILITY
  /// What the provider owes the platform (cash commission, refund after payout).
  PROVIDER_PLATFORM_DEBT
}

/// Application ledger accounts (not a statutory chart of accounts). This is
/// not a wallet holding money: funds stay at the licensed payment
/// institution (ADR-0008, ADR-0018).
model LedgerAccount {
  id         String            @id @default(uuid(7)) @db.Uuid
  type       LedgerAccountType
  /// Null for platform accounts.
  providerId String?           @map("provider_id") @db.Uuid
  /// "platform" for platform accounts, otherwise the provider id. Non-null
  /// so the unique key also covers platform accounts (NULLs never collide
  /// in a PostgreSQL unique index).
  ownerKey   String            @map("owner_key") @db.VarChar(64)
  currency   CurrencyCode      @default(TRY)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  entries  LedgerEntry[]

  @@unique([ownerKey, type, currency])
  @@index([providerId])
  @@map("ledger_accounts")
}

enum LedgerTransactionType {
  PAYMENT_CAPTURED
  EARNING_RELEASED
  CASH_FEE_ASSESSED
  REFUND_REQUESTED
  REFUND_COMPLETED
  PAYOUT_RESERVED
  PAYOUT_PAID
  /// Payout failed or cancelled: reserved money back to available.
  PAYOUT_RELEASED
  /// Mirror image of an earlier transaction (reverses_id).
  REVERSAL
  ADJUSTMENT
}

/// One financial event. Append-only (a database trigger refuses UPDATE and
/// DELETE); its entries balance: total debit = total credit (checked by a
/// deferred constraint trigger at commit). `source_key` is unique, so one
/// business event can be booked only once.
model LedgerTransaction {
  id               String                @id @default(uuid(7)) @db.Uuid
  type             LedgerTransactionType
  currency         CurrencyCode          @default(TRY)
  sourceKey        String                @unique @map("source_key") @db.VarChar(160)
  description      String?               @db.VarChar(300)
  jobId            String?               @map("job_id") @db.Uuid
  paymentId        String?               @map("payment_id") @db.Uuid
  refundId         String?               @map("refund_id") @db.Uuid
  payoutId         String?               @map("payout_id") @db.Uuid
  cashSettlementId String?               @map("cash_settlement_id") @db.Uuid
  earningId        String?               @map("earning_id") @db.Uuid
  providerId       String?               @map("provider_id") @db.Uuid
  /// Set on a REVERSAL; unique, so a transaction is reversed at most once.
  reversesId       String?               @unique @map("reverses_id") @db.Uuid
  createdById      String?               @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  job            Job?               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payment        Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund         Refund?            @relation(fields: [refundId], references: [id], onDelete: Restrict)
  payout         Payout?            @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  cashSettlement CashSettlement?    @relation(fields: [cashSettlementId], references: [id], onDelete: Restrict)
  earning        ProviderEarning?   @relation(fields: [earningId], references: [id], onDelete: Restrict)
  provider       ProviderProfile?   @relation("LedgerTransactionProvider", fields: [providerId], references: [id], onDelete: Restrict)
  reverses       LedgerTransaction? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     LedgerTransaction? @relation("LedgerReversal")
  createdBy      User?              @relation("LedgerTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  entries        LedgerEntry[]

  @@index([type, createdAt])
  @@index([providerId, createdAt])
  @@index([jobId])
  @@index([paymentId])
  @@index([refundId])
  @@index([payoutId])
  @@index([cashSettlementId])
  @@index([earningId])
  @@index([createdAt])
  @@map("ledger_transactions")
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Append-only. All entries of one transaction balance to zero.
model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  /// The ledger transaction (column name kept from Faz 1: journal).
  transactionId String          @map("journal_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  /// Always positive (DB check); `direction` carries the sign.
  amountMinor   BigInt          @map("amount_minor")
  currency      CurrencyCode    @default(TRY)
  paymentId     String?         @map("payment_id") @db.Uuid
  jobId         String?         @map("job_id") @db.Uuid
  description   String?         @db.VarChar(300)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment     Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ============================================================================
// Reviews, trust signals, discipline, appeals and disputes
// ============================================================================

enum ReviewDirection {
  CUSTOMER_TO_PROVIDER
  PROVIDER_TO_CUSTOMER
}

enum ReviewStatus {
  PUBLISHED
  UNDER_MODERATION
  HIDDEN
}

/// Reviews can only exist for a job, so every review is from a verified
/// customer (or provider). One review per direction per job.
model Review {
  id                  String          @id @default(uuid(7)) @db.Uuid
  jobId               String          @map("job_id") @db.Uuid
  direction           ReviewDirection
  authorId            String          @map("author_id") @db.Uuid
  targetId            String          @map("target_id") @db.Uuid
  /// 1-5.
  rating              Int             @db.SmallInt
  qualityRating       Int?            @map("quality_rating") @db.SmallInt
  punctualityRating   Int?            @map("punctuality_rating") @db.SmallInt
  communicationRating Int?            @map("communication_rating") @db.SmallInt
  priceRating         Int?            @map("price_rating") @db.SmallInt
  comment             String?         @db.VarChar(2000)
  status              ReviewStatus    @default(PUBLISHED)
  /// Last admin moderation (hide / restore); the history is in audit_logs.
  moderatedAt         DateTime?       @map("moderated_at") @db.Timestamptz(3)
  moderatedById       String?         @map("moderated_by_id") @db.Uuid
  moderationReason    String?         @map("moderation_reason") @db.VarChar(500)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  author      User                 @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target      User                 @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)
  moderatedBy User?                @relation("ReviewModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  reply       ProviderReviewReply?

  @@unique([jobId, direction])
  @@index([targetId, status, createdAt])
  @@map("reviews")
}

/// Faz 7: the provider's one public answer to a review about them. The
/// review text itself can never be changed by the provider.
model ProviderReviewReply {
  reviewId  String   @id @map("review_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("provider_review_replies")
}

/// Which side of the marketplace a trust signal or sanction applies to.
/// The same trust system covers providers and customers.
enum TrustSubjectRole {
  PROVIDER
  CUSTOMER
}

enum TrustEventType {
  JOB_COMPLETED
  ON_TIME_ARRIVAL
  LATE_ARRIVAL
  CANCELLED_AFTER_ACCEPT
  NO_SHOW
  QUOTE_RESPONSE_TIME
  REPEAT_CUSTOMER
  VERIFIED_COMPLAINT
  DISCIPLINARY_VIOLATION
  IDENTITY_VERIFIED
  CERTIFICATE_VERIFIED
  REVIEW_RECEIVED
}

/// Append-only UstaScore / trust input signals.
model TrustEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  subjectId   String           @map("subject_id") @db.Uuid
  subjectRole TrustSubjectRole @map("subject_role")
  type        TrustEventType
  /// Optional measured value, e.g. response time in seconds or minutes late.
  value       Int?
  jobId       String?          @map("job_id") @db.Uuid
  metadata    Json?
  occurredAt  DateTime         @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, subjectRole, type, occurredAt])
  @@map("trust_events")
}

enum DisciplinaryActionType {
  WARNING
  VISIBILITY_REDUCTION
  NOW_SUSPENSION
  JOB_RESTRICTION
  TEMPORARY_SUSPENSION
  PERMANENT_BAN
}

enum DisciplinaryActionStatus {
  ACTIVE
  UNDER_APPEAL
  /// Overturned on appeal or by an admin.
  REVOKED
  EXPIRED
}

/// Always decided by a person (decidedById) with a reason; a single bad
/// review never creates one automatically.
model DisciplinaryAction {
  id          String                   @id @default(uuid(7)) @db.Uuid
  subjectId   String                   @map("subject_id") @db.Uuid
  subjectRole TrustSubjectRole         @map("subject_role")
  type        DisciplinaryActionType
  status      DisciplinaryActionStatus @default(ACTIVE)
  reasonCode  String                   @map("reason_code") @db.VarChar(60)
  reason      String                   @db.VarChar(2000)
  decidedById String                   @map("decided_by_id") @db.Uuid
  disputeId   String?                  @map("dispute_id") @db.Uuid
  startsAt    DateTime                 @map("starts_at") @db.Timestamptz(3)
  /// Null = until revoked (PERMANENT_BAN, WARNING).
  endsAt      DateTime?                @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  subject   User     @relation("DisciplineSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  decidedBy User     @relation("DisciplineDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  dispute   Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  appeals   Appeal[]

  @@index([subjectId, subjectRole, status])
  @@index([status, endsAt])
  @@map("disciplinary_actions")
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Appeal {
  id                   String       @id @default(uuid(7)) @db.Uuid
  disciplinaryActionId String       @map("disciplinary_action_id") @db.Uuid
  appellantId          String       @map("appellant_id") @db.Uuid
  statement            String       @db.VarChar(4000)
  status               AppealStatus @default(SUBMITTED)
  reviewedById         String?      @map("reviewed_by_id") @db.Uuid
  decisionNote         String?      @map("decision_note") @db.VarChar(2000)
  decidedAt            DateTime?    @map("decided_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  disciplinaryAction DisciplinaryAction @relation(fields: [disciplinaryActionId], references: [id], onDelete: Restrict)
  appellant          User               @relation("AppealBy", fields: [appellantId], references: [id], onDelete: Restrict)
  reviewedBy         User?              @relation("AppealReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence           Evidence[]

  @@index([disciplinaryActionId])
  @@index([status])
  @@map("appeals")
}

enum DisputeStatus {
  OPEN
  AWAITING_EVIDENCE
  UNDER_REVIEW
  RESOLVED_FOR_CUSTOMER
  RESOLVED_FOR_PROVIDER
  RESOLVED_PARTIAL
  CLOSED
}

enum DisputeReason {
  NO_SHOW
  POOR_QUALITY
  PRICE_DISAGREEMENT
  PAYMENT_ISSUE
  DAMAGE
  MISCONDUCT
  OTHER
}

model Dispute {
  id           String        @id @default(uuid(7)) @db.Uuid
  jobId        String        @map("job_id") @db.Uuid
  paymentId    String?       @map("payment_id") @db.Uuid
  openedById   String        @map("opened_by_id") @db.Uuid
  againstId    String        @map("against_id") @db.Uuid
  reason       DisputeReason
  description  String        @db.VarChar(4000)
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.VarChar(2000)
  resolvedById String?       @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payment             Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  openedBy            User                 @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  against             User                 @relation("DisputeAgainst", fields: [againstId], references: [id], onDelete: Restrict)
  resolvedBy          User?                @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  evidence            Evidence[]
  disciplinaryActions DisciplinaryAction[]

  /// At most one unresolved dispute per job.
  @@unique([jobId], map: "disputes_one_open_per_job_key", where: raw("status = ANY (ARRAY['OPEN'::\"DisputeStatus\", 'AWAITING_EVIDENCE'::\"DisputeStatus\", 'UNDER_REVIEW'::\"DisputeStatus\"])"))
  @@index([jobId])
  @@index([status, createdAt])
  @@map("disputes")
}

enum EvidenceType {
  MESSAGE
  CHECK_IN
  LOCATION_EVENT
  PHOTO
  PAYMENT_RECORD
  DOCUMENT
  NOTE
}

/// Evidence attached to a dispute or an appeal. `referenceId` points at the
/// source record (a message, a location event, a payment transaction) once
/// those modules exist; files live in private object storage.
model Evidence {
  id            String       @id @default(uuid(7)) @db.Uuid
  disputeId     String?      @map("dispute_id") @db.Uuid
  appealId      String?      @map("appeal_id") @db.Uuid
  submittedById String       @map("submitted_by_id") @db.Uuid
  type          EvidenceType
  referenceId   String?      @map("reference_id") @db.Uuid
  storageKey    String?      @map("storage_key") @db.VarChar(512)
  note          String?      @db.VarChar(2000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  dispute     Dispute? @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  appeal      Appeal?  @relation(fields: [appealId], references: [id], onDelete: Cascade)
  submittedBy User     @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@index([appealId])
  @@map("evidence")
}

// ============================================================================
// Notifications and audit
// ============================================================================

enum NotificationChannel {
  PUSH
  IN_APP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  /// Event key, e.g. "quote.created", "emergency.new_request".
  type       String              @db.VarChar(60)
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  title      String              @db.VarChar(140)
  body       String              @db.VarChar(1000)
  data       Json?
  /// Faz 6 navigation metadata (docs/adr/0026). The app opens `deepLink`;
  /// the API still authorises the target on every request.
  entityType String?             @map("entity_type") @db.VarChar(40)
  entityId   String?             @map("entity_id") @db.VarChar(64)
  deepLink   String?             @map("deep_link") @db.VarChar(200)
  /// Faz 7 notification centre tab: JOBS | MESSAGES | FINANCE | ACCOUNT.
  category   String?             @db.VarChar(16)
  sentAt     DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt     DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDelivery PushDelivery?

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([userId, category, createdAt])
  @@map("notifications")
}

/// Per-user switches (docs/adr/0017). Job updates are transactional and
/// always delivered in the app and by push; only these categories can be
/// turned off.
model NotificationPreference {
  userId           String          @id @map("user_id") @db.Uuid
  /// New quotes, counter offers, accepted / rejected quotes.
  quoteUpdatesPush Boolean         @default(true) @map("quote_updates_push")
  /// Campaigns. Nothing is sent in this phase; stored for consent.
  marketingPush    Boolean         @default(false) @map("marketing_push")
  /// Faz 7: chat messages.
  newMessagePush   Boolean         @default(true) @map("new_message_push")
  /// Faz 7, providers: new matching jobs ON / SILENT (in-app only) / OFF.
  newJobAlerts     NewJobAlertMode @default(ON) @map("new_job_alerts")
  /// Quiet hours (minutes from local midnight, Europe/Istanbul); both or neither.
  quietHoursStart  Int?            @map("quiet_hours_start") @db.SmallInt
  quietHoursEnd    Int?            @map("quiet_hours_end") @db.SmallInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum NewJobAlertMode {
  ON
  SILENT
  OFF
}

enum PushDeliveryStatus {
  /// Waiting for the push worker (first try or a retry).
  PENDING
  /// Handed to the push service for at least one device.
  SENT
  /// Development only: written to the API log by the console provider.
  /// Nothing left the server; never reported as a real delivery.
  DEV_LOGGED
  /// Gave up after the last retry.
  FAILED
  /// Nothing to send: no registered device, or the user turned it off.
  SKIPPED
}

/// Push outbox (docs/adr/0017). Written in the same transaction as the
/// in-app notification; the worker sends it after commit. The in-app row
/// stays the source of truth whatever happens here. Delivery attempts are
/// kept here, never in audit_logs.
model PushDelivery {
  id             String             @id @default(uuid(7)) @db.Uuid
  notificationId String             @unique @map("notification_id") @db.Uuid
  status         PushDeliveryStatus @default(PENDING)
  attemptCount   Int                @default(0) @map("attempt_count") @db.SmallInt
  nextAttemptAt  DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime?          @map("last_attempt_at") @db.Timestamptz(3)
  lastError      String?            @map("last_error") @db.VarChar(500)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  tickets      PushTicket[]

  @@index([status, nextAttemptAt])
  @@map("push_deliveries")
}

enum PushTicketStatus {
  /// Accepted by the push service; a receipt follows.
  OK
  ERROR
}

enum PushReceiptStatus {
  PENDING
  OK
  ERROR
  /// No receipt id (ticket error) or the provider has no receipts.
  NOT_APPLICABLE
}

/// One device's answer from the push service for a delivery.
model PushTicket {
  id               String            @id @default(uuid(7)) @db.Uuid
  deliveryId       String            @map("delivery_id") @db.Uuid
  deviceId         String            @map("device_id") @db.Uuid
  /// "expo" or "console"; console tickets are never real deliveries.
  provider         String            @db.VarChar(20)
  /// The push service's ticket id, used to fetch the receipt.
  ticketId         String?           @map("ticket_id") @db.VarChar(100)
  status           PushTicketStatus
  error            String?           @db.VarChar(100)
  receiptStatus    PushReceiptStatus @default(PENDING) @map("receipt_status")
  receiptError     String?           @map("receipt_error") @db.VarChar(100)
  receiptCheckedAt DateTime?         @map("receipt_checked_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery PushDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  device   Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([receiptStatus, createdAt])
  @@index([deliveryId])
  @@map("push_tickets")
}

/// Append-only log of security-relevant and admin actions.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// e.g. "auth.login", "auth.refresh_reuse", "user.role_granted".
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// Faz 6: provider verification and trust (docs/adr/0023)
// ============================================================================

/// Verification workflow of a provider. Transitions only through
/// providers/domain/verification-state-machine.ts.
enum ProviderVerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEEDS_REVISION
  SUSPENDED
}

/// One verification case per provider (the "single active verification"
/// invariant is the unique provider_id). History is in
/// provider_verification_events. No identity number is stored: a future
/// KYC provider's result is kept as `external_reference` only.
model ProviderVerificationCase {
  id                 String                     @id @default(uuid(7)) @db.Uuid
  providerId         String                     @unique @map("provider_id") @db.Uuid
  status             ProviderVerificationStatus @default(NOT_STARTED)
  /// MANUAL today; the adapter name of a KYC provider later.
  method             String                     @default("MANUAL") @db.VarChar(30)
  externalReference  String?                    @map("external_reference") @db.VarChar(120)
  submittedAt        DateTime?                  @map("submitted_at") @db.Timestamptz(3)
  submissionCount    Int                        @default(0) @map("submission_count")
  reviewStartedAt    DateTime?                  @map("review_started_at") @db.Timestamptz(3)
  /// Admin who took the case into review.
  reviewedByAdminId  String?                    @map("reviewed_by_admin_id") @db.Uuid
  decidedAt          DateTime?                  @map("decided_at") @db.Timestamptz(3)
  /// Admin who made the last decision (may differ from the reviewer: a
  /// future four-eyes rule needs both).
  decisionByAdminId  String?                    @map("decision_by_admin_id") @db.Uuid
  decisionReasonCode String?                    @map("decision_reason_code") @db.VarChar(60)
  /// Shown to the provider.
  userVisibleReason  String?                    @map("user_visible_reason") @db.VarChar(500)
  /// Staff only; never returned by a provider or public endpoint.
  internalNote       String?                    @map("internal_note") @db.VarChar(2000)
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(3)
  /// WORKFLOW, LEGACY_BACKFILL (Faz 2 approvals) or DEMO_SEED.
  source             String                     @default("WORKFLOW") @db.VarChar(30)
  version            Int                        @default(0)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider  ProviderProfile             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewer  User?                       @relation("VerificationCaseReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  decider   User?                       @relation("VerificationCaseDecider", fields: [decisionByAdminId], references: [id], onDelete: SetNull)
  documents ProviderVerification[]
  events    ProviderVerificationEvent[]

  @@index([status, submittedAt])
  @@map("provider_verification_cases")
}

/// Append-only timeline of a verification case (DB trigger).
model ProviderVerificationEvent {
  id                String                      @id @default(uuid(7)) @db.Uuid
  caseId            String                      @map("case_id") @db.Uuid
  providerId        String                      @map("provider_id") @db.Uuid
  event             String                      @db.VarChar(40)
  fromStatus        ProviderVerificationStatus? @map("from_status")
  toStatus          ProviderVerificationStatus  @map("to_status")
  /// PROVIDER, ADMIN or SYSTEM.
  actorType         String                      @map("actor_type") @db.VarChar(20)
  actorId           String?                     @map("actor_id") @db.Uuid
  reasonCode        String?                     @map("reason_code") @db.VarChar(60)
  userVisibleReason String?                     @map("user_visible_reason") @db.VarChar(500)
  internalNote      String?                     @map("internal_note") @db.VarChar(2000)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  case     ProviderVerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider ProviderProfile          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  actor    User?                    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("provider_verification_events")
}

/// Admin-configurable document requirement per category (a product rule,
/// not a legal one: nothing here encodes Turkish regulation).
model CategoryProviderRequirement {
  id            String           @id @default(uuid(7)) @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  documentType  VerificationType @map("document_type")
  note          String?          @db.VarChar(300)
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(3)

  category  ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([categoryId, documentType], map: "category_provider_requirements_live_key", where: raw("deactivated_at IS NULL"))
  @@map("category_provider_requirements")
}

/// Product access of a provider; not the same thing as verification.
enum ProviderAccountStatus {
  ACTIVE
  /// Can quote, cannot take NOW jobs or request payouts.
  LIMITED
  /// No new quotes, NOW jobs or payouts; running jobs continue.
  SUSPENDED
  BANNED
}

enum ProviderSuspensionStatus {
  ACTIVE
  LIFTED
  /// expires_at passed and auto_lift was set: access restored by the sweep.
  EXPIRED
  /// expires_at passed without auto_lift: stays suspended until an admin
  /// reviews it (docs/adr/0023).
  EXPIRED_PENDING_REVIEW
}

/// An account restriction decided by an admin (docs/adr/0023). Separate
/// from Faz 4 penalties (ranking signals) and from verification.
model ProviderSuspension {
  id                String                   @id @default(uuid(7)) @db.Uuid
  providerId        String                   @map("provider_id") @db.Uuid
  status            ProviderSuspensionStatus @default(ACTIVE)
  /// Account status while this suspension is in force.
  level             ProviderAccountStatus
  reasonCode        String                   @map("reason_code") @db.VarChar(60)
  internalNote      String                   @map("internal_note") @db.VarChar(2000)
  userVisibleReason String                   @map("user_visible_reason") @db.VarChar(500)
  startsAt          DateTime                 @map("starts_at") @db.Timestamptz(3)
  expiresAt         DateTime?                @map("expires_at") @db.Timestamptz(3)
  autoLift          Boolean                  @default(false) @map("auto_lift")
  createdById       String?                  @map("created_by_id") @db.Uuid
  liftedById        String?                  @map("lifted_by_id") @db.Uuid
  liftedAt          DateTime?                @map("lifted_at") @db.Timestamptz(3)
  liftNote          String?                  @map("lift_note") @db.VarChar(2000)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("SuspensionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  liftedBy  User?           @relation("SuspensionLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)

  /// One suspension in force per provider.
  @@unique([providerId], map: "provider_suspensions_one_open_key", where: raw("status = ANY (ARRAY['ACTIVE'::\"ProviderSuspensionStatus\", 'EXPIRED_PENDING_REVIEW'::\"ProviderSuspensionStatus\"])"))
  @@index([status, expiresAt])
  @@index([providerId, createdAt])
  @@map("provider_suspensions")
}

// ============================================================================
// Faz 6: admin permissions, risk signals (docs/adr/0024)
// ============================================================================

/// Fine-grained staff permissions on top of the ADMIN role. SUPER_ADMIN
/// (role) and ADMIN_SUPER (permission) imply every permission.
enum AdminPermission {
  ADMIN_SUPPORT
  ADMIN_VERIFICATION
  ADMIN_FINANCE
  ADMIN_SUPER
}

model AdminPermissionGrant {
  userId      String          @map("user_id") @db.Uuid
  permission  AdminPermission
  grantedById String?         @map("granted_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("AdminPermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("AdminPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, permission])
  @@map("admin_permission_grants")
}

enum RiskSignalType {
  OTP_ABUSE
  QUOTE_SPAM
  CANCEL_ABUSE
  PAYMENT_ABUSE
  REVIEW_ABUSE
  DEVICE_ANOMALY
  ADMIN_FLAG
}

enum RiskSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
}

/// An observed, explainable fact ("12 OTP requests from one IP in an
/// hour"), never a score and never an automatic sanction.
model RiskSignal {
  id            String           @id @default(uuid(7)) @db.Uuid
  type          RiskSignalType
  status        RiskSignalStatus @default(OPEN)
  subjectUserId String?          @map("subject_user_id") @db.Uuid
  /// Keyed hash of a phone or IP when there is no user (never the raw value).
  subjectKey    String?          @map("subject_key") @db.VarChar(64)
  /// Counts and ids only, no personal data.
  evidence      Json
  source        String           @db.VarChar(60)
  dedupeKey     String           @map("dedupe_key") @db.VarChar(160)
  occurrences   Int              @default(1)
  lastSeenAt    DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  reviewedById  String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewNote    String?          @map("review_note") @db.VarChar(1000)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  subject    User? @relation("RiskSignalSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("RiskSignalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([dedupeKey], map: "risk_signals_open_dedupe_key", where: raw("status = 'OPEN'"))
  @@index([status, createdAt])
  @@index([subjectUserId, createdAt])
  @@map("risk_signals")
}

// ============================================================================
// Faz 6: operations, observability, reconciliation (docs/adr/0026)
// ============================================================================

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Something an operator must look at. The system only raises alerts; it
/// never "fixes" money or data on its own.
model OperationalAlert {
  id               String        @id @default(uuid(7)) @db.Uuid
  type             String        @db.VarChar(60)
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  title            String        @db.VarChar(200)
  details          Json
  source           String        @db.VarChar(60)
  /// Repeats of an unresolved alert bump `occurrences` instead of piling up.
  dedupeKey        String        @map("dedupe_key") @db.VarChar(160)
  occurrences      Int           @default(1)
  lastSeenAt       DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedById     String?       @map("resolved_by_id") @db.Uuid
  resolutionNote   String?       @map("resolution_note") @db.VarChar(2000)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  acknowledgedBy User? @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     User? @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([dedupeKey], map: "operational_alerts_open_dedupe_key", where: raw("status <> 'RESOLVED'"))
  @@index([status, createdAt])
  @@index([severity, status])
  @@map("operational_alerts")
}

enum ReconciliationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// One finance reconciliation (scheduled, manual or CLI). Read-only check;
/// a mismatch only raises an alert.
model FinanceReconciliationRun {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  trigger               String                  @db.VarChar(20)
  status                ReconciliationRunStatus @default(RUNNING)
  startedAt             DateTime                @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt            DateTime?               @map("finished_at") @db.Timestamptz(3)
  counts                Json?
  debitTotalMinor       BigInt?                 @map("debit_total_minor")
  creditTotalMinor      BigInt?                 @map("credit_total_minor")
  mismatchCount         Int?                    @map("mismatch_count")
  /// First mismatches (bounded), ids and codes only.
  mismatches            Json?
  snapshotsChecked      Int                     @default(0) @map("snapshots_checked")
  snapshotMismatchCount Int                     @default(0) @map("snapshot_mismatch_count")
  error                 String?                 @db.VarChar(500)
  alertId               String?                 @map("alert_id") @db.Uuid

  /// At most one RUNNING row: the row itself is the cross-replica lock.
  @@unique([status], map: "finance_reconciliation_runs_one_running_key", where: raw("status = 'RUNNING'::\"ReconciliationRunStatus\""))
  @@index([startedAt])
  @@map("finance_reconciliation_runs")
}

/// Daily per-account balance summary computed from the ledger. A cache
/// for reports and a tamper check; never a source of truth.
model LedgerAccountSnapshot {
  id               String   @id @default(uuid(7)) @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  asOf             DateTime @map("as_of") @db.Timestamptz(3)
  debitTotalMinor  BigInt   @map("debit_total_minor")
  creditTotalMinor BigInt   @map("credit_total_minor")
  entryCount       Int      @map("entry_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([accountId, asOf])
  @@index([asOf])
  @@map("ledger_account_snapshots")
}

/// Last run of each background worker, for the Operations page.
model WorkerHeartbeat {
  name                String    @id @db.VarChar(60)
  lastRunAt           DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(3)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  totalRuns           Int       @default(0) @map("total_runs")
  totalFailures       Int       @default(0) @map("total_failures")
  lastError           String?   @map("last_error") @db.VarChar(500)
  lastDurationMs      Int?      @map("last_duration_ms")
  lastResult          Json?     @map("last_result")
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("worker_heartbeats")
}

/// Feature switches an admin may turn OFF at runtime (kill switch). The
/// env flag is the ceiling: the effective value is env AND this row, so an
/// admin can never enable what the deployment disabled.
model RuntimeFlag {
  key         String   @id @db.VarChar(60)
  enabled     Boolean
  reason      String   @db.VarChar(500)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("runtime_flags")
}

// ============================================================================
// Faz 6: account deletion and data export (docs/adr/0027)
// ============================================================================

enum AccountDeletionStatus {
  REQUESTED
  BLOCKED_BY_ACTIVE_JOB
  PROCESSING
  COMPLETED
  CANCELLED
}

model AccountDeletionRequest {
  id          String                @id @default(uuid(7)) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  status      AccountDeletionStatus @default(REQUESTED)
  /// Codes of what blocks completion (ACTIVE_JOB, OPEN_DISPUTE, ...).
  blockers    Json                  @default("[]")
  requestedAt DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  processedAt DateTime?             @map("processed_at") @db.Timestamptz(3)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId], map: "account_deletion_requests_one_open_key", where: raw("status = ANY (ARRAY['REQUESTED'::\"AccountDeletionStatus\", 'BLOCKED_BY_ACTIVE_JOB'::\"AccountDeletionStatus\", 'PROCESSING'::\"AccountDeletionStatus\"])"))
  @@index([status, requestedAt])
  @@map("account_deletion_requests")
}

enum DataExportStatus {
  REQUESTED
  PROCESSING
  READY
  EXPIRED
  FAILED
}

/// Recorded request for a personal data export. Generating the archive is
/// not implemented yet (docs/adr/0027); the request is kept so none is lost.
model DataExportRequest {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      DataExportStatus @default(REQUESTED)
  requestedAt DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  readyAt     DateTime?        @map("ready_at") @db.Timestamptz(3)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(3)
  storageKey  String?          @map("storage_key") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("data_export_requests")
}

// ============================================================================
// Faz 7: job/request-bound messaging (docs/adr/0030)
// ============================================================================

enum MessageType {
  TEXT
  IMAGE
  /// Server-generated event ("Teklif ₺2.200 olarak kabul edildi.").
  SYSTEM
}

enum ConversationRole {
  CUSTOMER
  PROVIDER
}

/// One conversation per (service request, provider): it starts with the
/// provider's quote and continues into the job. Never a general chat.
model Conversation {
  id               String    @id @default(uuid(7)) @db.Uuid
  serviceRequestId String    @map("service_request_id") @db.Uuid
  providerId       String    @map("provider_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  jobId            String?   @map("job_id") @db.Uuid
  lastMessageAt    DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest ServiceRequest            @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  provider       ProviderProfile           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  customer       CustomerProfile           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  job            Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  participants   ConversationParticipant[]
  messages       Message[]
  reports        MessageReport[]

  @@unique([serviceRequestId, providerId])
  @@index([jobId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           ConversationRole
  /// createdAt of the newest message this participant has read.
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(3)
  /// "Kendimden gizle": hidden in this user's list only; kept on the server.
  hiddenAt       DateTime?        @map("hidden_at") @db.Timestamptz(3)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id                  String      @id @default(uuid(7)) @db.Uuid
  conversationId      String      @map("conversation_id") @db.Uuid
  /// Null for SYSTEM messages.
  senderId            String?     @map("sender_id") @db.Uuid
  type                MessageType
  body                String?     @db.VarChar(2000)
  /// Client-generated id: a retried send returns the first message.
  clientMessageId     String?     @map("client_message_id") @db.Uuid
  /// SYSTEM only: one message per event ("quote_accepted:<quoteId>").
  eventKey            String?     @map("event_key") @db.VarChar(120)
  uploadIntentId      String?     @unique @map("upload_intent_id") @db.Uuid
  storageKey          String?     @map("storage_key") @db.VarChar(512)
  mimeType            String?     @map("mime_type") @db.VarChar(100)
  sizeBytes           Int?        @map("size_bytes")
  /// Looks like a phone number or e-mail (detection only, never blocked).
  containsContactInfo Boolean     @default(false) @map("contains_contact_info")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt            DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?           @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  uploadIntent UploadIntent?   @relation(fields: [uploadIntentId], references: [id], onDelete: Restrict)
  reports      MessageReport[]

  @@unique([conversationId, senderId, clientMessageId])
  @@unique([conversationId, eventKey])
  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  FRAUD
  CONTACT_INFO
  INAPPROPRIATE
  OTHER
}

enum MessageReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

/// "Mesajı bildir". Support may open the reported conversation only with a
/// reason, and every opening is audited.
model MessageReport {
  id             String              @id @default(uuid(7)) @db.Uuid
  messageId      String              @map("message_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  reporterId     String              @map("reporter_id") @db.Uuid
  reason         MessageReportReason
  note           String?             @db.VarChar(500)
  status         MessageReportStatus @default(OPEN)
  reviewedById   String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  resolutionNote String?             @map("resolution_note") @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("MessageReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("MessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
  @@map("message_reports")
}

/// A user blocked another. Stops new messages between them; an active
/// job's workflow (steps, payment, completion) is never blocked.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

// ============================================================================
// Faz 7: marketplace analytics events (docs/adr/0028)
// ============================================================================

/// Event names as used in the Faz 7 brief.
enum MarketplaceEventType {
  request_created
  request_dispatched
  provider_viewed_request
  quote_created
  quote_accepted
  job_started
  job_completed
  conversation_started
  message_sent
  provider_favorited
  provider_rehired
  search_performed
  search_no_result
  search_category_clicked
  request_no_offer
  request_search_expanded
}

/// Append-only. Never holds message bodies, addresses, phone numbers,
/// national ids, IBANs or user ids: only marketplace ids, region, category
/// and small numeric values.
model MarketplaceEvent {
  id               String               @id @default(uuid(7)) @db.Uuid
  type             MarketplaceEventType
  occurredAt       DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  serviceRequestId String?              @map("service_request_id") @db.Uuid
  providerId       String?              @map("provider_id") @db.Uuid
  categoryId       String?              @map("category_id") @db.Uuid
  provinceId       Int?                 @map("province_id") @db.SmallInt
  districtId       String?              @map("district_id") @db.Uuid
  /// Small numeric payload: wave number, result count, minutes.
  value            Int?
  /// Low-cardinality extras (normalised search text without digits, wave).
  metadata         Json?

  serviceRequest ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  province       Province?        @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  district       District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([serviceRequestId, occurredAt])
  @@index([provinceId, type, occurredAt])
  @@index([categoryId, type, occurredAt])
  @@map("marketplace_events")
}
