// UstaGO database schema (Phase 1 domain core).
//
// Conventions (docs/adr/0003, 0006, 0008):
// - Every table has a UUIDv7 `id` (time-ordered, generated by Prisma).
//   Exceptions: provinces use the official plate code (1-81); pure join
//   tables use a composite key; 1:1 extension tables (provider_scores) use
//   the owner's id.
// - Table and column names are snake_case via @@map / @map; code uses camelCase.
// - Money is BigInt minor units (kuruş for TRY) plus a `currency`; never Float.
// - Timestamps are timestamptz and stored in UTC.
// - Append-only history tables (quote revisions, job status history, ledger
//   entries, trust events, audit logs) have `createdAt` but no `updatedAt`:
//   their rows are never edited.
// - Mutable aggregates that several actors race on carry a `version` column
//   for optimistic locking (service requests, quotes, jobs, change orders,
//   payments).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Shared enums
// ============================================================================

/// ISO 4217. Adding a currency is a one-line enum migration.
enum CurrencyCode {
  TRY
}

// ============================================================================
// Identity, roles and sessions
// ============================================================================

enum UserStatus {
  ACTIVE
  /// Cannot sign in until an admin reactivates the account.
  SUSPENDED
  BANNED
}

/// A user can hold several roles at once (ADR-0005). CUSTOMER is granted to
/// every account; PROVIDER is added when the user opens a provider profile.
enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased and trimmed by the API.
  email           String?    @unique @db.VarChar(254)
  /// E.164, e.g. +905321234567.
  phone           String?    @unique @db.VarChar(20)
  /// Argon2id hash. Null for accounts that will only use OTP login later.
  passwordHash    String?    @map("password_hash")
  firstName       String     @map("first_name") @db.VarChar(80)
  lastName        String     @map("last_name") @db.VarChar(80)
  status          UserStatus @default(ACTIVE)
  locale          String     @default("tr-TR") @db.VarChar(10)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete; personal data is anonymised by a later KVKK job.
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  roles              UserRole[]             @relation("UserRoles")
  grantedRoles       UserRole[]             @relation("RoleGrantedBy")
  customerProfile    CustomerProfile?
  providerProfile    ProviderProfile?
  addresses          Address[]
  sessions           AuthSession[]
  devices            Device[]
  notifications      Notification[]
  quoteRevisions     QuoteRevision[]
  jobStatusChanges   JobStatusHistory[]
  jobsCancelled      Job[]                  @relation("JobCancelledBy")
  changeOrdersAsked  ChangeOrder[]          @relation("ChangeOrderRequestedBy")
  changeOrdersAnswer ChangeOrder[]          @relation("ChangeOrderRespondedBy")
  paymentsMade       Payment[]
  reviewsWritten     Review[]               @relation("ReviewAuthor")
  reviewsReceived    Review[]               @relation("ReviewTarget")
  verificationsDone  ProviderVerification[]
  trustEvents        TrustEvent[]
  disciplinary       DisciplinaryAction[]   @relation("DisciplineSubject")
  disciplineDecided  DisciplinaryAction[]   @relation("DisciplineDecidedBy")
  appeals            Appeal[]               @relation("AppealBy")
  appealsReviewed    Appeal[]               @relation("AppealReviewedBy")
  disputesOpened     Dispute[]              @relation("DisputeOpenedBy")
  disputesAgainst    Dispute[]              @relation("DisputeAgainst")
  disputesResolved   Dispute[]              @relation("DisputeResolvedBy")
  evidence           Evidence[]
  auditLogs          AuditLog[]

  @@index([status])
  @@map("users")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  role        Role
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// One row per sign-in (a refresh-token family). Access tokens carry the
/// session id, so revoking a session also invalidates its access tokens.
model AuthSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String?   @map("device_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  /// Absolute lifetime; rotation never extends past this.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// LOGOUT, LOGOUT_ALL, TOKEN_REUSE, ADMIN, PASSWORD_CHANGE...
  revokedReason String?   @map("revoked_reason") @db.VarChar(40)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Refresh tokens are opaque random strings; only their SHA-256 hash is
/// stored. Each refresh consumes the token and issues a new one. Presenting
/// an already consumed token revokes the whole session (reuse detection).
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum PushProvider {
  EXPO
  FCM
  APNS
}

model Device {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  platform     DevicePlatform
  pushProvider PushProvider?  @map("push_provider")
  /// A push token belongs to one device install; re-registering moves it.
  pushToken    String?        @unique @map("push_token") @db.VarChar(512)
  deviceName   String?        @map("device_name") @db.VarChar(120)
  appVersion   String?        @map("app_version") @db.VarChar(40)
  lastSeenAt   DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions AuthSession[]

  @@index([userId])
  @@map("devices")
}

// ============================================================================
// Location (Turkey-wide: 81 il, ilçe)
// ============================================================================

/// Official province (il). `id` is the plate code, 1-81.
model Province {
  id        Int      @id @db.SmallInt
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(60)
  /// Marketplace open in this province (pilot cities first).
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  districts       District[]
  addresses       Address[]
  serviceRequests ServiceRequest[]
  categoryRules   ProvinceCategory[]

  @@map("provinces")
}

model District {
  id         String   @id @default(uuid(7)) @db.Uuid
  provinceId Int      @map("province_id") @db.SmallInt
  name       String   @db.VarChar(80)
  slug       String   @db.VarChar(80)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  province        Province              @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  addresses       Address[]
  serviceRequests ServiceRequest[]
  providerAreas   ProviderServiceArea[]

  @@unique([provinceId, slug])
  @@map("districts")
}

/// Per-province switch for a category (e.g. Çilingir NOW open in İstanbul
/// but not yet in Ankara). Missing row = follow the category's defaults.
model ProvinceCategory {
  provinceId Int      @map("province_id") @db.SmallInt
  categoryId String   @map("category_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  nowEnabled Boolean  @default(false) @map("now_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  province Province        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([provinceId, categoryId])
  @@map("province_categories")
}

model Address {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  label        String?   @db.VarChar(40)
  provinceId   Int       @map("province_id") @db.SmallInt
  districtId   String    @map("district_id") @db.Uuid
  neighborhood String?   @db.VarChar(120)
  addressLine  String    @map("address_line") @db.VarChar(300)
  buildingNo   String?   @map("building_no") @db.VarChar(20)
  apartmentNo  String?   @map("apartment_no") @db.VarChar(20)
  postalCode   String?   @map("postal_code") @db.VarChar(10)
  /// WGS84. PostGIS can replace these when geo queries need it.
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  province        Province         @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district        District         @relation(fields: [districtId], references: [id], onDelete: Restrict)
  serviceRequests ServiceRequest[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================================
// Customer and provider profiles
// ============================================================================

model CustomerProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  jobs            Job[]

  @@map("customer_profiles")
}

enum ProviderStatus {
  /// Profile opened, onboarding not finished. Not listed.
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

model ProviderProfile {
  id                String         @id @default(uuid(7)) @db.Uuid
  userId            String         @unique @map("user_id") @db.Uuid
  type              ProviderType   @default(INDIVIDUAL)
  status            ProviderStatus @default(DRAFT)
  displayName       String         @map("display_name") @db.VarChar(120)
  bio               String?        @db.VarChar(2000)
  yearsOfExperience Int?           @map("years_of_experience") @db.SmallInt
  /// Provider opted in to UstaGO NOW (emergency) jobs.
  nowEnabled        Boolean        @default(false) @map("now_enabled")
  /// Currently accepting NOW jobs ("müsaitim" toggle).
  isAvailableNow    Boolean        @default(false) @map("is_available_now")
  lastLatitude      Decimal?       @map("last_latitude") @db.Decimal(9, 6)
  lastLongitude     Decimal?       @map("last_longitude") @db.Decimal(9, 6)
  lastLocationAt    DateTime?      @map("last_location_at") @db.Timestamptz(3)
  approvedAt        DateTime?      @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services       ProviderService[]
  serviceAreas   ProviderServiceArea[]
  verifications  ProviderVerification[]
  score          ProviderScore?
  quotes         Quote[]
  jobs           Job[]
  dispatchOffers EmergencyDispatchOffer[]
  ledgerAccounts LedgerAccount[]

  @@index([status, nowEnabled, isAvailableNow])
  @@map("provider_profiles")
}

model ProviderService {
  providerId String   @map("provider_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("provider_services")
}

model ProviderServiceArea {
  providerId String   @map("provider_id") @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  district District        @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@id([providerId, districtId])
  @@index([districtId])
  @@map("provider_service_areas")
}

enum VerificationType {
  IDENTITY
  PROFESSIONAL_CERTIFICATE
  TAX_REGISTRATION
  BUSINESS_LICENSE
  CRIMINAL_RECORD
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ProviderVerification {
  id              String             @id @default(uuid(7)) @db.Uuid
  providerId      String             @map("provider_id") @db.Uuid
  type            VerificationType
  status          VerificationStatus @default(PENDING)
  /// Private object-storage key; files are served only via signed URLs.
  documentKey     String?            @map("document_key") @db.VarChar(512)
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?            @map("rejection_reason") @db.VarChar(500)
  expiresAt       DateTime?          @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([providerId, type])
  @@index([status])
  @@map("provider_verifications")
}

/// Latest computed UstaScore. Inputs are TrustEvents and reviews; paid plans
/// are never an input (organic ranking cannot be bought, ADR-0008).
model ProviderScore {
  providerId       String   @id @map("provider_id") @db.Uuid
  /// 0.00-100.00.
  score            Decimal  @db.Decimal(5, 2)
  /// Number of completed jobs the score is based on.
  sampleSize       Int      @default(0) @map("sample_size")
  /// Cold start: new providers get a bounded exposure boost instead of
  /// being invisible until they collect reviews.
  isNewProvider    Boolean  @default(true) @map("is_new_provider")
  /// Signal breakdown used for the score, for transparency and appeals.
  components       Json     @default("{}")
  algorithmVersion String   @map("algorithm_version") @db.VarChar(20)
  computedAt       DateTime @map("computed_at") @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("provider_scores")
}

// ============================================================================
// Catalog
// ============================================================================

model ServiceCategory {
  id            String   @id @default(uuid(7)) @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  slug          String   @unique @db.VarChar(80)
  name          String   @db.VarChar(80)
  description   String?  @db.VarChar(500)
  icon          String?  @db.VarChar(60)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  /// Category can be requested as UstaGO NOW (emergency).
  supportsNow   Boolean  @default(false) @map("supports_now")
  /// Category can be requested through "Teklif Al".
  supportsQuote Boolean  @default(true) @map("supports_quote")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          ServiceCategory?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        ServiceCategory[]  @relation("CategoryTree")
  provinceRules   ProvinceCategory[]
  providers       ProviderService[]
  serviceRequests ServiceRequest[]
  jobs            Job[]

  @@index([parentId, sortOrder])
  @@map("service_categories")
}

// ============================================================================
// Service requests, NOW dispatch, quotes and negotiation
// ============================================================================

enum ServiceRequestType {
  /// UstaGO NOW / Acil Usta.
  NOW
  /// Teklif Al.
  QUOTE
}

enum ServiceRequestStatus {
  DRAFT
  PUBLISHED
  MATCHING
  QUOTED
  MATCHED
  CANCELLED
  EXPIRED
  COMPLETED
}

model ServiceRequest {
  id               String               @id @default(uuid(7)) @db.Uuid
  customerId       String               @map("customer_id") @db.Uuid
  categoryId       String               @map("category_id") @db.Uuid
  addressId        String               @map("address_id") @db.Uuid
  /// Denormalised from the address for regional search.
  provinceId       Int                  @map("province_id") @db.SmallInt
  districtId       String               @map("district_id") @db.Uuid
  type             ServiceRequestType
  status           ServiceRequestStatus @default(DRAFT)
  title            String               @db.VarChar(140)
  description      String               @db.VarChar(4000)
  /// Customer's expectation only; never binds a provider's quote.
  /// Null = "Bütçem belli değil / teklif almak istiyorum".
  budgetMinor      BigInt?              @map("budget_minor")
  currency         CurrencyCode         @default(TRY)
  preferredStartAt DateTime?            @map("preferred_start_at") @db.Timestamptz(3)
  preferredEndAt   DateTime?            @map("preferred_end_at") @db.Timestamptz(3)
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(3)
  expiresAt        DateTime?            @map("expires_at") @db.Timestamptz(3)
  cancelledAt      DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  version          Int                  @default(0)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       CustomerProfile          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category       ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  address        Address                  @relation(fields: [addressId], references: [id], onDelete: Restrict)
  province       Province                 @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district       District                 @relation(fields: [districtId], references: [id], onDelete: Restrict)
  quotes         Quote[]
  dispatchOffers EmergencyDispatchOffer[]
  job            Job?

  @@index([customerId, createdAt])
  @@index([status, type, provinceId, categoryId])
  @@map("service_requests")
}

enum DispatchOfferStatus {
  SENT
  SEEN
  ACCEPTED
  DECLINED
  /// Another provider accepted first, or the customer cancelled.
  SUPERSEDED
  EXPIRED
}

/// One row per provider notified about a NOW request. The first ACCEPTED
/// row wins; the unique Job.serviceRequestId makes a double accept fail.
model EmergencyDispatchOffer {
  id               String              @id @default(uuid(7)) @db.Uuid
  serviceRequestId String              @map("service_request_id") @db.Uuid
  providerId       String              @map("provider_id") @db.Uuid
  status           DispatchOfferStatus @default(SENT)
  /// Distance at dispatch time, for ranking and analytics.
  distanceMeters   Int?                @map("distance_meters")
  sentAt           DateTime            @default(now()) @map("sent_at") @db.Timestamptz(3)
  respondedAt      DateTime?           @map("responded_at") @db.Timestamptz(3)
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, providerId])
  @@index([providerId, status])
  @@map("emergency_dispatch_offers")
}

enum QuoteStatus {
  /// Waiting for the customer to answer the provider's latest offer.
  PENDING_CUSTOMER
  /// Waiting for the provider to answer the customer's counter offer.
  PENDING_PROVIDER
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// One negotiation thread between a provider and a service request. Every
/// price change is a new QuoteRevision; nothing is overwritten.
model Quote {
  id                 String       @id @default(uuid(7)) @db.Uuid
  serviceRequestId   String       @map("service_request_id") @db.Uuid
  providerId         String       @map("provider_id") @db.Uuid
  status             QuoteStatus  @default(PENDING_CUSTOMER)
  currency           CurrencyCode @default(TRY)
  /// Set when the thread is accepted; points at the accepted revision.
  acceptedRevisionId String?      @unique @map("accepted_revision_id") @db.Uuid
  acceptedAt         DateTime?    @map("accepted_at") @db.Timestamptz(3)
  version            Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  provider         ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  revisions        QuoteRevision[] @relation("QuoteRevisions")
  acceptedRevision QuoteRevision?  @relation("AcceptedRevision", fields: [acceptedRevisionId], references: [id], onDelete: Restrict)
  job              Job?

  @@unique([serviceRequestId, providerId])
  @@index([providerId, status])
  @@map("quotes")
}

enum QuoteRevisionKind {
  /// Provider's first offer.
  OFFER
  /// Customer's counter offer.
  CUSTOMER_COUNTER
  /// Provider's revised or counter offer.
  PROVIDER_COUNTER
}

/// Immutable. Revision 1 is always the provider's OFFER.
model QuoteRevision {
  id                       String            @id @default(uuid(7)) @db.Uuid
  quoteId                  String            @map("quote_id") @db.Uuid
  revisionNo               Int               @map("revision_no")
  kind                     QuoteRevisionKind
  authorUserId             String            @map("author_user_id") @db.Uuid
  totalMinor               BigInt            @map("total_minor")
  laborMinor               BigInt?           @map("labor_minor")
  materialMinor            BigInt?           @map("material_minor")
  materialsIncluded        Boolean?          @map("materials_included")
  currency                 CurrencyCode      @default(TRY)
  note                     String?           @db.VarChar(2000)
  estimatedDurationMinutes Int?              @map("estimated_duration_minutes")
  availableFrom            DateTime?         @map("available_from") @db.Timestamptz(3)
  availableUntil           DateTime?         @map("available_until") @db.Timestamptz(3)
  validUntil               DateTime?         @map("valid_until") @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  quote         Quote  @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Cascade)
  author        User   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  acceptedQuote Quote? @relation("AcceptedRevision")
  jobs          Job[]

  @@unique([quoteId, revisionNo])
  @@map("quote_revisions")
}

// ============================================================================
// Jobs (a booking and its execution), status history and change orders
// ============================================================================

enum JobStatus {
  CREATED
  CONFIRMED
  PROVIDER_PREPARING
  PROVIDER_EN_ROUTE
  PROVIDER_ARRIVED
  IN_PROGRESS
  AWAITING_COMPLETION_CONFIRMATION
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentMethod {
  IN_APP
  CASH
  BANK_TRANSFER
}

/// Created when a quote is accepted or a NOW offer is accepted. Booking and
/// job are one aggregate (ADR-0008): scheduling fields live here.
model Job {
  id                 String         @id @default(uuid(7)) @db.Uuid
  /// Unique: one job per request, so two accepts cannot both succeed.
  serviceRequestId   String         @unique @map("service_request_id") @db.Uuid
  quoteId            String?        @unique @map("quote_id") @db.Uuid
  acceptedRevisionId String?        @map("accepted_revision_id") @db.Uuid
  customerId         String         @map("customer_id") @db.Uuid
  providerId         String         @map("provider_id") @db.Uuid
  categoryId         String         @map("category_id") @db.Uuid
  status             JobStatus      @default(CREATED)
  /// AGREED_PRICE: locked when the job is created and never updated.
  agreedPriceMinor   BigInt         @map("agreed_price_minor")
  /// agreedPriceMinor + accepted change orders. Changes only through an
  /// accepted ChangeOrder, in the same transaction.
  currentTotalMinor  BigInt         @map("current_total_minor")
  currency           CurrencyCode   @default(TRY)
  paymentMethod      PaymentMethod? @map("payment_method")
  scheduledStartAt   DateTime?      @map("scheduled_start_at") @db.Timestamptz(3)
  startedAt          DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?        @map("cancelled_by_id") @db.Uuid
  cancellationReason String?        @map("cancellation_reason") @db.VarChar(500)
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequest   ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  quote            Quote?             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  acceptedRevision QuoteRevision?     @relation(fields: [acceptedRevisionId], references: [id], onDelete: Restrict)
  customer         CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider         ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category         ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cancelledBy      User?              @relation("JobCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  statusHistory    JobStatusHistory[]
  changeOrders     ChangeOrder[]
  payments         Payment[]
  reviews          Review[]
  disputes         Dispute[]
  ledgerEntries    LedgerEntry[]

  @@index([customerId, createdAt])
  @@index([providerId, status])
  @@map("jobs")
}

/// Append-only. Written by the job state machine in the same transaction
/// as the status change.
model JobStatusHistory {
  id          String     @id @default(uuid(7)) @db.Uuid
  jobId       String     @map("job_id") @db.Uuid
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  reason      String?    @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@map("job_status_history")
}

enum ChangeOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

/// "Ek 3 metre boru gerekiyor +600 TL". The provider proposes, the customer
/// decides; a rejected change keeps the previous total.
model ChangeOrder {
  id                 String            @id @default(uuid(7)) @db.Uuid
  jobId              String            @map("job_id") @db.Uuid
  requestedById      String            @map("requested_by_id") @db.Uuid
  description        String            @db.VarChar(1000)
  /// Signed: positive adds work, negative removes it.
  amountDeltaMinor   BigInt            @map("amount_delta_minor")
  currency           CurrencyCode      @default(TRY)
  /// Job total when the change was proposed and the total it would become.
  previousTotalMinor BigInt            @map("previous_total_minor")
  proposedTotalMinor BigInt            @map("proposed_total_minor")
  status             ChangeOrderStatus @default(PENDING)
  respondedById      String?           @map("responded_by_id") @db.Uuid
  respondedAt        DateTime?         @map("responded_at") @db.Timestamptz(3)
  version            Int               @default(0)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ChangeOrderRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  respondedBy User? @relation("ChangeOrderRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([jobId, status])
  @@map("change_orders")
}

// ============================================================================
// Payments (provider-agnostic) and ledger
// ============================================================================

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
  DISPUTED
  /// Direct (cash / bank transfer) payment confirmed by both sides.
  SETTLED_OFFLINE
}

/// One payment intent for a job. For IN_APP payments `gateway` names the
/// licensed payment institution adapter (e.g. "mock", later iyzico/PayTR);
/// the domain never depends on a specific provider.
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  jobId            String        @map("job_id") @db.Uuid
  payerId          String        @map("payer_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amountMinor      BigInt        @map("amount_minor")
  platformFeeMinor BigInt        @default(0) @map("platform_fee_minor")
  currency         CurrencyCode  @default(TRY)
  gateway          String?       @db.VarChar(40)
  gatewayReference String?       @map("gateway_reference") @db.VarChar(120)
  /// Client-supplied key: retrying the same request never charges twice.
  idempotencyKey   String        @unique @map("idempotency_key") @db.VarChar(80)
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job           Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payer         User                 @relation(fields: [payerId], references: [id], onDelete: Restrict)
  transactions  PaymentTransaction[]
  ledgerEntries LedgerEntry[]
  disputes      Dispute[]

  @@unique([gateway, gatewayReference])
  @@index([jobId])
  @@map("payments")
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  VOID
  REFUND
  CHARGEBACK
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Each call to (or webhook from) the payment gateway.
model PaymentTransaction {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  paymentId            String                   @map("payment_id") @db.Uuid
  type                 PaymentTransactionType
  status               PaymentTransactionStatus @default(PENDING)
  amountMinor          BigInt                   @map("amount_minor")
  currency             CurrencyCode             @default(TRY)
  gatewayTransactionId String?                  @map("gateway_transaction_id") @db.VarChar(120)
  /// Webhook deliveries are de-duplicated on this key.
  idempotencyKey       String                   @unique @map("idempotency_key") @db.VarChar(120)
  failureCode          String?                  @map("failure_code") @db.VarChar(60)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_transactions")
}

enum LedgerAccountType {
  /// Provider earnings not yet released (job not confirmed / hold period).
  PROVIDER_PENDING
  /// Provider earnings released and payable.
  PROVIDER_AVAILABLE
  /// Paid out to the provider's bank account.
  PROVIDER_PAID_OUT
  /// Money held by the licensed payment institution for the platform.
  PLATFORM_CLEARING
  PLATFORM_FEE_REVENUE
  REFUNDS
}

/// Double-entry bookkeeping of what UstaGO owes whom. This is not a wallet
/// holding money: funds stay at the licensed payment institution (ADR-0008).
model LedgerAccount {
  id         String            @id @default(uuid(7)) @db.Uuid
  type       LedgerAccountType
  /// Null for platform accounts.
  providerId String?           @map("provider_id") @db.Uuid
  currency   CurrencyCode      @default(TRY)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  entries  LedgerEntry[]

  @@unique([providerId, type, currency])
  @@map("ledger_accounts")
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Append-only. All entries sharing a `journalId` balance to zero.
model LedgerEntry {
  id          String          @id @default(uuid(7)) @db.Uuid
  journalId   String          @map("journal_id") @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  direction   LedgerDirection
  /// Always positive; `direction` carries the sign.
  amountMinor BigInt          @map("amount_minor")
  currency    CurrencyCode    @default(TRY)
  paymentId   String?         @map("payment_id") @db.Uuid
  jobId       String?         @map("job_id") @db.Uuid
  description String?         @db.VarChar(300)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  job     Job?          @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([journalId])
  @@map("ledger_entries")
}

// ============================================================================
// Reviews, trust signals, discipline, appeals and disputes
// ============================================================================

enum ReviewDirection {
  CUSTOMER_TO_PROVIDER
  PROVIDER_TO_CUSTOMER
}

enum ReviewStatus {
  PUBLISHED
  UNDER_MODERATION
  HIDDEN
}

/// Reviews can only exist for a job, so every review is from a verified
/// customer (or provider). One review per direction per job.
model Review {
  id                  String          @id @default(uuid(7)) @db.Uuid
  jobId               String          @map("job_id") @db.Uuid
  direction           ReviewDirection
  authorId            String          @map("author_id") @db.Uuid
  targetId            String          @map("target_id") @db.Uuid
  /// 1-5.
  rating              Int             @db.SmallInt
  qualityRating       Int?            @map("quality_rating") @db.SmallInt
  punctualityRating   Int?            @map("punctuality_rating") @db.SmallInt
  communicationRating Int?            @map("communication_rating") @db.SmallInt
  priceRating         Int?            @map("price_rating") @db.SmallInt
  comment             String?         @db.VarChar(2000)
  status              ReviewStatus    @default(PUBLISHED)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target User @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([jobId, direction])
  @@index([targetId, status])
  @@map("reviews")
}

/// Which side of the marketplace a trust signal or sanction applies to.
/// The same trust system covers providers and customers.
enum TrustSubjectRole {
  PROVIDER
  CUSTOMER
}

enum TrustEventType {
  JOB_COMPLETED
  ON_TIME_ARRIVAL
  LATE_ARRIVAL
  CANCELLED_AFTER_ACCEPT
  NO_SHOW
  QUOTE_RESPONSE_TIME
  REPEAT_CUSTOMER
  VERIFIED_COMPLAINT
  DISCIPLINARY_VIOLATION
  IDENTITY_VERIFIED
  CERTIFICATE_VERIFIED
  REVIEW_RECEIVED
}

/// Append-only UstaScore / trust input signals.
model TrustEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  subjectId   String           @map("subject_id") @db.Uuid
  subjectRole TrustSubjectRole @map("subject_role")
  type        TrustEventType
  /// Optional measured value, e.g. response time in seconds or minutes late.
  value       Int?
  jobId       String?          @map("job_id") @db.Uuid
  metadata    Json?
  occurredAt  DateTime         @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  subject User @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, subjectRole, type, occurredAt])
  @@map("trust_events")
}

enum DisciplinaryActionType {
  WARNING
  VISIBILITY_REDUCTION
  NOW_SUSPENSION
  JOB_RESTRICTION
  TEMPORARY_SUSPENSION
  PERMANENT_BAN
}

enum DisciplinaryActionStatus {
  ACTIVE
  UNDER_APPEAL
  /// Overturned on appeal or by an admin.
  REVOKED
  EXPIRED
}

/// Always decided by a person (decidedById) with a reason; a single bad
/// review never creates one automatically.
model DisciplinaryAction {
  id          String                   @id @default(uuid(7)) @db.Uuid
  subjectId   String                   @map("subject_id") @db.Uuid
  subjectRole TrustSubjectRole         @map("subject_role")
  type        DisciplinaryActionType
  status      DisciplinaryActionStatus @default(ACTIVE)
  reasonCode  String                   @map("reason_code") @db.VarChar(60)
  reason      String                   @db.VarChar(2000)
  decidedById String                   @map("decided_by_id") @db.Uuid
  disputeId   String?                  @map("dispute_id") @db.Uuid
  startsAt    DateTime                 @map("starts_at") @db.Timestamptz(3)
  /// Null = until revoked (PERMANENT_BAN, WARNING).
  endsAt      DateTime?                @map("ends_at") @db.Timestamptz(3)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  subject   User     @relation("DisciplineSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  decidedBy User     @relation("DisciplineDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  dispute   Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  appeals   Appeal[]

  @@index([subjectId, subjectRole, status])
  @@map("disciplinary_actions")
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Appeal {
  id                   String       @id @default(uuid(7)) @db.Uuid
  disciplinaryActionId String       @map("disciplinary_action_id") @db.Uuid
  appellantId          String       @map("appellant_id") @db.Uuid
  statement            String       @db.VarChar(4000)
  status               AppealStatus @default(SUBMITTED)
  reviewedById         String?      @map("reviewed_by_id") @db.Uuid
  decisionNote         String?      @map("decision_note") @db.VarChar(2000)
  decidedAt            DateTime?    @map("decided_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  disciplinaryAction DisciplinaryAction @relation(fields: [disciplinaryActionId], references: [id], onDelete: Restrict)
  appellant          User               @relation("AppealBy", fields: [appellantId], references: [id], onDelete: Restrict)
  reviewedBy         User?              @relation("AppealReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidence           Evidence[]

  @@index([disciplinaryActionId])
  @@index([status])
  @@map("appeals")
}

enum DisputeStatus {
  OPEN
  AWAITING_EVIDENCE
  UNDER_REVIEW
  RESOLVED_FOR_CUSTOMER
  RESOLVED_FOR_PROVIDER
  RESOLVED_PARTIAL
  CLOSED
}

enum DisputeReason {
  NO_SHOW
  POOR_QUALITY
  PRICE_DISAGREEMENT
  PAYMENT_ISSUE
  DAMAGE
  MISCONDUCT
  OTHER
}

model Dispute {
  id           String        @id @default(uuid(7)) @db.Uuid
  jobId        String        @map("job_id") @db.Uuid
  paymentId    String?       @map("payment_id") @db.Uuid
  openedById   String        @map("opened_by_id") @db.Uuid
  againstId    String        @map("against_id") @db.Uuid
  reason       DisputeReason
  description  String        @db.VarChar(4000)
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.VarChar(2000)
  resolvedById String?       @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job                 Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  payment             Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  openedBy            User                 @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  against             User                 @relation("DisputeAgainst", fields: [againstId], references: [id], onDelete: Restrict)
  resolvedBy          User?                @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  evidence            Evidence[]
  disciplinaryActions DisciplinaryAction[]

  @@index([jobId])
  @@index([status])
  @@map("disputes")
}

enum EvidenceType {
  MESSAGE
  CHECK_IN
  LOCATION_EVENT
  PHOTO
  PAYMENT_RECORD
  DOCUMENT
  NOTE
}

/// Evidence attached to a dispute or an appeal. `referenceId` points at the
/// source record (a message, a location event, a payment transaction) once
/// those modules exist; files live in private object storage.
model Evidence {
  id            String       @id @default(uuid(7)) @db.Uuid
  disputeId     String?      @map("dispute_id") @db.Uuid
  appealId      String?      @map("appeal_id") @db.Uuid
  submittedById String       @map("submitted_by_id") @db.Uuid
  type          EvidenceType
  referenceId   String?      @map("reference_id") @db.Uuid
  storageKey    String?      @map("storage_key") @db.VarChar(512)
  note          String?      @db.VarChar(2000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  dispute     Dispute? @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  appeal      Appeal?  @relation(fields: [appealId], references: [id], onDelete: Cascade)
  submittedBy User     @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@index([appealId])
  @@map("evidence")
}

// ============================================================================
// Notifications and audit
// ============================================================================

enum NotificationChannel {
  PUSH
  IN_APP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  /// Event key, e.g. "quote.created", "emergency.new_request".
  type      String              @db.VarChar(60)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String              @db.VarChar(140)
  body      String              @db.VarChar(1000)
  data      Json?
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Append-only log of security-relevant and admin actions.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// e.g. "auth.login", "auth.refresh_reuse", "user.role_granted".
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
