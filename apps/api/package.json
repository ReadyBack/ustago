{
  "name": "@ustago/api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "prisma:reset": "prisma migrate reset && prisma db seed",
    "finance:reconcile": "tsx src/finance/reconcile.cli.ts",
    "config:check": "tsx src/config-check.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@ustago/config": "workspace:*",
    "@ustago/types": "workspace:*",
    "@ustago/validation": "workspace:*",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@ustago/eslint-config": "workspace:*",
    "@ustago/tsconfig": "workspace:*",
    "eslint": "^9.39.0",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.2"
  }
}
