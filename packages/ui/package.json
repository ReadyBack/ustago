{
  "name": "@ustago/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens shared by admin and mobile.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@ustago/eslint-config": "workspace:*",
    "@ustago/tsconfig": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
